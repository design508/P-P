[
  {
    "name": "theme_info",
    "theme_name": "Pups & Paws Brand Studio",
    "theme_version": "10.0.0",
    "theme_author": "Custom theme",
    "theme_documentation_url": "https://help.shopify.com/en/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand and layout",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "header",
        "content": "Brand colours"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary purple",
        "default": "#47105d"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary purple",
        "default": "#5b1a74"
      },
      {
        "type": "color",
        "id": "color_orange",
        "label": "Orange accent",
        "default": "#ff5a0a"
      },
      {
        "type": "color",
        "id": "color_pink",
        "label": "Pink accent",
        "default": "#ff2b78"
      },
      {
        "type": "color",
        "id": "color_green",
        "label": "Green accent",
        "default": "#61f46f"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Main text",
        "default": "#351042"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#6a5872"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders and dividers",
        "default": "#eee7f0"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1800,
        "step": 50,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1500
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 40,
        "max": 140,
        "step": 5,
        "unit": "px",
        "label": "Section spacing - desktop",
        "default": 90
      },
      {
        "type": "range",
        "id": "section_spacing_mobile",
        "min": 32,
        "max": 92,
        "step": 5,
        "unit": "px",
        "label": "Section spacing - mobile",
        "default": 62
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 40
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 24
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable motion and reveal effects",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_ambient_motion",
        "label": "Enable ambient floating background shapes",
        "default": true,
        "info": "Slow-drifting decorative shapes in the page margins on wide screens, so pages feel alive even without their own hero art. Automatically turned off when 'Enable motion and reveal effects' above is off, or for visitors who prefer reduced motion."
      }
    ]
  },
  {
    "name": "Typography",
