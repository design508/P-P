  {
    "name": "Popups and cart",
    "settings": [
      {
        "type": "header",
        "content": "Welcome / offer popup"
      },
      {
        "type": "checkbox",
        "id": "popup_enable",
        "label": "Enable popup",
        "default": true
      },
      {
        "type": "range",
        "id": "popup_delay",
        "min": 1,
        "max": 20,
        "step": 1,
        "unit": "s",
        "label": "Popup delay",
        "default": 4
      },
      {
        "type": "select",
        "id": "popup_frequency",
        "label": "Show again",
        "default": "session",
        "options": [
          {
            "value": "always",
            "label": "Every visit"
          },
          {
            "value": "session",
            "label": "Once per browser session"
          },
          {
            "value": "7days",
            "label": "After 7 days"
          }
        ]
      },
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "Popup image"
