        "default": "700",
        "options": [
          {
            "value": "400",
            "label": "Regular"
          },
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semibold"
          },
          {
            "value": "700",
            "label": "Bold"
          }
        ]
      },
      {
        "type": "range",
        "id": "button_font_size",
        "min": 11,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Button text size",
        "default": 13
