{% render 'section-editor-styles', section: section %}
{{ 'pp-hero-life.css' | asset_url | stylesheet_tag }}
{% assign hero_image_block = nil %}
{% for block in section.blocks %}
  {% if block.type == 'main_image' %}
    {% assign hero_image_block = block %}
  {% endif %}
{% endfor %}
{% assign main_hero_image = hero_image_block.settings.image | default: section.settings.hero_image | default: section.settings.lifestyle_image %}
{% assign main_hero_image_mobile = hero_image_block.settings.image_mobile %}
{% assign hero_display_image = main_hero_image | default: main_hero_image_mobile %}
{% assign hero_img_fit = hero_image_block.settings.image_fit | default: 'contain' %}
{% assign hero_img_position = hero_image_block.settings.image_position | default: 'center center' %}
{% assign hero_img_radius = hero_image_block.settings.image_radius | default: 0 %}
{% assign hero_box_w = hero_image_block.settings.image_max_width | default: 0 %}
{% assign hero_box_h = hero_image_block.settings.image_max_height | default: 0 %}
{% assign hero_box_h_align = hero_image_block.settings.box_h_align | default: 'default' %}
{% assign hero_box_v_align = hero_image_block.settings.box_v_align | default: 'default' %}
{% assign hero_img_fit_m = hero_image_block.settings.image_fit_mobile | default: 'contain' %}
{% assign hero_img_position_m = hero_image_block.settings.image_position_mobile | default: 'center center' %}
{% assign hero_img_radius_m = hero_image_block.settings.image_radius_mobile | default: 0 %}
{% assign hero_box_w_m = hero_image_block.settings.image_max_width_mobile | default: 0 %}
{% assign hero_box_h_m = hero_image_block.settings.image_max_height_mobile | default: 0 %}
{% assign hero_box_h_align_m = hero_image_block.settings.box_h_align_mobile | default: 'default' %}
{% assign hero_box_v_align_m = hero_image_block.settings.box_v_align_mobile | default: 'default' %}
<style>
  @media (min-width: 991px) {
    #shopify-section-{{ section.id }} .live-hero__lifestyle img {
      object-fit: {{ hero_img_fit }};
      object-position: {{ hero_img_position }};
    }
    #shopify-section-{{ section.id }} .live-hero__lifestyle {
      {% if hero_img_radius > 0 %}border-radius: {{ hero_img_radius }}px;{% endif %}
      {% if hero_box_w > 0 %}width: min({{ hero_box_w }}px, 100%); max-width: 100%;{% endif %}
      {% if hero_box_h > 0 %}height: min({{ hero_box_h }}px, 100%); max-height: 100%;{% endif %}
      {% if hero_box_h_align == 'left' %}left: 0; right: auto; margin-left: 0; margin-right: 0;{% endif %}
      {% if hero_box_h_align == 'center' %}left: 0; right: 0; margin-left: auto; margin-right: auto;{% endif %}
      {% if hero_box_h_align == 'right' %}left: auto; right: 0; margin-left: 0; margin-right: 0;{% endif %}
      {% if hero_box_v_align == 'top' %}top: 0; bottom: auto; margin-top: 0; margin-bottom: 0;{% endif %}
      {% if hero_box_v_align == 'center' %}top: 0; bottom: 0; margin-top: auto; margin-bottom: auto;{% endif %}
      {% if hero_box_v_align == 'bottom' %}top: auto; bottom: 0; margin-top: 0; margin-bottom: 0;{% endif %}
    }
  }
  {% comment %}
    Mobile/tablet (990px and narrower) gets its own independent set of image
    settings instead of inheriting the desktop ones. Height is capped in three
    tiers matching the same breakpoints theme.css already uses for
    .live-hero__stage's own min-height (460px / 520px / 405px), so the box can
    never grow taller than the space actually available at that width —
    exactly the same "never overflow" guarantee the desktop fix uses, just
    expressed as explicit tiers instead of a percentage, since .live-hero__stage
    isn't stretched to a definite height on mobile the way it is on desktop.
  {% endcomment %}
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .live-hero__lifestyle img {
      object-fit: {{ hero_img_fit_m }};
      object-position: {{ hero_img_position_m }};
    }
    #shopify-section-{{ section.id }} .live-hero__lifestyle {
      {% if hero_img_radius_m > 0 %}border-radius: {{ hero_img_radius_m }}px;{% endif %}
      {% if hero_box_w_m > 0 %}width: min({{ hero_box_w_m }}px, 100%); max-width: 100%;{% endif %}
      {% if hero_box_h_m > 0 %}height: min({{ hero_box_h_m }}px, 460px); max-height: 460px;{% endif %}
      {% if hero_box_h_align_m == 'left' %}left: 0; right: auto; margin-left: 0; margin-right: 0;{% endif %}
      {% if hero_box_h_align_m == 'center' %}left: 0; right: 0; margin-left: auto; margin-right: auto;{% endif %}
      {% if hero_box_h_align_m == 'right' %}left: auto; right: 0; margin-left: 0; margin-right: 0;{% endif %}
      {% if hero_box_v_align_m == 'top' %}top: 0; bottom: auto; margin-top: 0; margin-bottom: 0;{% endif %}
      {% if hero_box_v_align_m == 'center' %}top: 0; bottom: 0; margin-top: auto; margin-bottom: auto;{% endif %}
      {% if hero_box_v_align_m == 'bottom' %}top: auto; bottom: 0; margin-top: 0; margin-bottom: 0;{% endif %}
    }
  }
  {% if hero_box_h_m > 0 %}
    @media (max-width: 900px) {
      #shopify-section-{{ section.id }} .live-hero__lifestyle {
        height: min({{ hero_box_h_m }}px, 520px);
        max-height: 520px;
      }
    }
    @media (max-width: 680px) {
      #shopify-section-{{ section.id }} .live-hero__lifestyle {
        height: min({{ hero_box_h_m }}px, 405px);
        max-height: 405px;
      }
    }
  {% endif %}
  {% if section.settings.pp_custom_spacing %}
    #shopify-section-{{ section.id }} .live-hero {
      padding-top: clamp({{ section.settings.pp_padding_top | times: 0.85 }}px, {{ section.settings.pp_padding_top | divided_by: 14.4 }}vw, {{ section.settings.pp_padding_top | times: 1.35 }}px) !important;
      padding-bottom: clamp({{ section.settings.pp_padding_bottom | times: 0.85 }}px, {{ section.settings.pp_padding_bottom | divided_by: 14.4 }}vw, {{ section.settings.pp_padding_bottom | times: 1.35 }}px) !important;
    }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .live-hero {
        padding-top: {{ section.settings.pp_padding_top_mobile }}px !important;
        padding-bottom: {{ section.settings.pp_padding_bottom_mobile }}px !important;
      }
    }
  {% endif %}
  #shopify-section-{{ section.id }} .live-hero__lifestyle,
  #shopify-section-{{ section.id }} .live-hero__lifestyle img {
    opacity: 1 !important;
    filter: none !important;
    mix-blend-mode: normal !important;
  }
  #shopify-section-{{ section.id }} .live-hero__lifestyle--placeholder:empty {
    display: none;
  }
  #shopify-section-{{ section.id }} .live-hero__lifestyle--placeholder {
    position: relative;
    min-height: clamp(272px, 22.2222vw, 432px);
    border: 2px dashed rgba(71, 16, 93, 0.28);
    border-radius: clamp(24px, 1.9444vw, 38px);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .live-hero__lifestyle--placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
    min-height: clamp(272px, 22.2222vw, 432px);
    opacity: 0.2;
  }
  #shopify-section-{{ section.id }} .live-hero__placeholder-label {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    padding: clamp(9px,.6944vw,14px) clamp(14px,1.1111vw,22px);
    border-radius: 999px;
    background: #fff;
    color: #47105d;
    font-size: clamp(12px,.9722vw,19px);
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(71, 16, 93, 0.12);
  }
</style>
<section class="live-hero" style="--hero-a:{{ section.settings.background_1 }};--hero-b:{{ section.settings.background_2 }};--hero-accent:{{ section.settings.accent }}">
  <span class="live-doodle live-doodle--paw live-doodle--paw-1">◌</span>
  <span class="live-doodle live-doodle--paw live-doodle--paw-2">◌</span>
  <div class="page-width live-hero__grid">
    <div class="live-hero__copy pp-reveal">
      {% if section.settings.eyebrow != blank %}<div class="live-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="live-actions">
        {% if section.settings.primary_label != blank %}<a class="pp-btn pp-btn--purple" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }} {% render 'icon-arrow' %}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="pp-btn live-btn-ghost" href="{{ section.settings.secondary_link | default: '/collections/grooming' }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
      <div class="live-trust">
        {% assign badges = shop.metaobjects.trust_badge.values %}
        {% if section.settings.use_trust_metaobjects and badges != blank %}
          {% for badge in badges limit: 3 %}<span>{% if badge.icon.value != blank %}{{ badge.icon.value | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}{% else %}<i>✦</i>{% endif %}{{ badge.title.value | default: badge.title }}</span>{% endfor %}
        {% else %}
          {% if section.settings.trust_1 != blank %}<span><i>◇</i>{{ section.settings.trust_1 }}</span>{% endif %}
          {% if section.settings.trust_2 != blank %}<span><i>☀</i>{{ section.settings.trust_2 }}</span>{% endif %}
          {% if section.settings.trust_3 != blank %}<span><i>♡</i>{{ section.settings.trust_3 }}</span>{% endif %}
        {% endif %}
      </div>
    </div>
    <div class="live-hero__stage pp-reveal" data-float-zone>
      <span class="live-hero__word" aria-hidden="true">WOOF</span>
      <span class="live-hero__blob live-hero__blob--1"></span><span class="live-hero__blob live-hero__blob--2"></span>
      <div class="live-hero__lifestyle{% if hero_display_image == blank %} live-hero__lifestyle--placeholder{% endif %}"{% if hero_image_block %} {{ hero_image_block.shopify_attributes }}{% endif %}>
        {% if hero_display_image != blank %}
          <picture>
            {% if main_hero_image_mobile != blank and main_hero_image_mobile != main_hero_image %}
              <source media="(max-width: 990px)" srcset="{{ main_hero_image_mobile | image_url: width: 400 }} 400w, {{ main_hero_image_mobile | image_url: width: 600 }} 600w, {{ main_hero_image_mobile | image_url: width: 800 }} 800w, {{ main_hero_image_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
            {% endif %}
            {{ hero_display_image | image_url: width: 1500 | image_tag: loading: 'eager', widths: '700,1000,1300,1500', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.heading }}
          </picture>
        {% elsif request.design_mode %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          <span class="live-hero__placeholder-label">{% if hero_image_block %}Click to select main hero image{% else %}Select main hero image{% endif %}</span>
        {% endif %}
      </div>
      <div class="live-hero__pack" aria-label="{{ section.settings.product_group_label }}">
        {% assign product_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            {% assign product_index = product_index | plus: 1 %}
            {% assign p = block.settings.product %}
            {% assign hero_link = block.settings.link %}
            {% if hero_link == blank and p != blank %}{% assign hero_link = p.url %}{% endif %}
            <a {% if hero_link != blank %}href="{{ hero_link }}"{% endif %} class="live-hero__product live-hero__product--{{ product_index }}" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }} style="--product-accent:{{ block.settings.color }}">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading:'eager', widths:'280,420,600,800', alt:block.settings.short_label | default: p.title | default: section.settings.heading }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
              <span>{{ block.settings.short_label | default: p.title }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
      {% if section.settings.badge_text != blank %}<div class="live-hero__badge">{{ section.settings.badge_text | newline_to_br }}</div>{% endif %}
    </div>
  </div>
</section>
{% schema %}
