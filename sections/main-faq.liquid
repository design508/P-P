{% render 'section-editor-styles', section: section %}
{% assign global_faqs = shop.metaobjects.faq_item.values %}
<section class="pp-page-hero"><div class="page-width"><span class="pp-kicker pp-kicker--pink">QUICK ANSWERS</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div></section>
<section class="pp-faq"><div class="page-width"><div class="pp-faq__list">
  {% if section.settings.use_metaobjects and global_faqs != blank %}
    {% for item in global_faqs %}<details><summary>{{ item.question.value | default: item.question }}<span>+</span></summary><div class="rte">{{ item.answer | metafield_tag }}</div></details>{% endfor %}
  {% endif %}
  {% for block in section.blocks %}<details data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span>+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}
  {% if request.design_mode and global_faqs == blank and section.blocks.size == 0 %}<p>Add FAQ item metaobjects or verified FAQ blocks.</p>{% endif %}
</div></div></section>
