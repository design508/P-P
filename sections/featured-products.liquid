{% render 'section-editor-styles', section: section %}
<section class="pp-section pp-products" style="background:{{ section.settings.background }}">
  <div class="page-width">
    <div class="pp-products__head">
      <div><div class="pp-kicker">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>
      {% if section.settings.collection != blank and section.settings.view_label != blank %}<a class="pp-text-link" href="{{ section.settings.collection.url }}">{{ section.settings.view_label }} {% render 'icon-arrow' %}</a>{% endif %}
    </div>
    <div class="pp-product-grid">
      {% assign collection = section.settings.collection %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product, eyebrow: section.settings.card_eyebrow %}
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
        <article class="pp-card"><div class="pp-card__media pp-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div><div class="pp-card__body"><span class="pp-kicker">{{ section.settings.card_eyebrow }}</span><h3>{{ section.settings.empty_heading }}</h3><p>{{ section.settings.empty_text }}</p></div></article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
