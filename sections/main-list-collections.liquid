{% render 'section-editor-styles', section: section %}
<section class="pp-section" style="background:{{ section.settings.background }}"><div class="page-width">
  <div class="pp-center"><div class="pp-kicker">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1></div>
  <div class="pp-product-grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign c = block.settings.collection %}
        {% if c != blank %}
{% assign image_img = block.settings.image %}
{% assign image_img_mobile = block.settings.image_mobile %}
{% assign image_display = image_img | default: image_img_mobile %}
{% assign image_fit = block.settings.image_fit | default: 'contain' %}
{% assign image_position = block.settings.image_position | default: 'center center' %}
{% assign image_fit_m = block.settings.image_fit_mobile | default: 'contain' %}
{% assign image_position_m = block.settings.image_position_mobile | default: 'center center' %}
{% assign image_radius = block.settings.image_radius | default: 0 %}
{% assign image_radius_m = block.settings.image_radius_mobile | default: 0 %}
{% assign image_w = block.settings.image_max_width | default: 0 %}
{% assign image_h = block.settings.image_max_height | default: 0 %}
{% assign image_w_m = block.settings.image_max_width_mobile | default: 0 %}
{% assign image_h_m = block.settings.image_max_height_mobile | default: 0 %}
{% assign image_ha = block.settings.image_h_align | default: 'default' %}
{% assign image_va = block.settings.image_v_align | default: 'default' %}
{% assign image_ha_m = block.settings.image_h_align_mobile | default: 'default' %}
{% assign image_va_m = block.settings.image_v_align_mobile | default: 'default' %}
          <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-card[data-pp-block-id="{{ block.id }}"] .pp-card__media img { object-fit: {{ image_fit }}; object-position: {{ image_position }}; }
  #shopify-section-{{ section.id }} .pp-card[data-pp-block-id="{{ block.id }}"] .pp-card__media {
    {% if image_radius > 0 %}border-radius: {{ image_radius }}px; overflow: hidden;{% endif %}
    {% if image_w > 0 %}width: min({{ image_w }}px, 100%); max-width: 100%;{% endif %}
    {% if image_h > 0 %}height: min({{ image_h }}px, 100%); max-height: 100%;{% endif %}
    {% if image_ha == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if image_ha == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if image_ha == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if image_va == 'top' %}align-self: flex-start;{% endif %}
    {% if image_va == 'center' %}align-self: center;{% endif %}
    {% if image_va == 'bottom' %}align-self: flex-end;{% endif %}
  }
}
@media (max-width: 990px) {
  #shopify-section-{{ section.id }} .pp-card[data-pp-block-id="{{ block.id }}"] .pp-card__media img { object-fit: {{ image_fit_m }}; object-position: {{ image_position_m }}; }
  #shopify-section-{{ section.id }} .pp-card[data-pp-block-id="{{ block.id }}"] .pp-card__media {
    {% if image_radius_m > 0 %}border-radius: {{ image_radius_m }}px; overflow: hidden;{% endif %}
    {% if image_w_m > 0 %}width: min({{ image_w_m }}px, 100%); max-width: 100%;{% endif %}
    {% if image_h_m > 0 %}height: min({{ image_h_m }}px, 100%); max-height: 100%;{% endif %}
    {% if image_ha_m == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if image_ha_m == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if image_ha_m == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if image_va_m == 'top' %}align-self: flex-start;{% endif %}
    {% if image_va_m == 'center' %}align-self: center;{% endif %}
    {% if image_va_m == 'bottom' %}align-self: flex-end;{% endif %}
  }
}</style>
          <article class="pp-card" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            <a class="pp-card__media" href="{{ c.url }}">{% if image_display != blank %}
  <picture>
    {% if image_img_mobile != blank and image_img_mobile != image_img %}
      <source media="(max-width: 990px)" srcset="{{ image_img_mobile | image_url: width: 400 }} 400w, {{ image_img_mobile | image_url: width: 600 }} 600w, {{ image_img_mobile | image_url: width: 800 }} 800w, {{ image_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ image_display | image_url: width: 800 | image_tag: loading: 'lazy', alt: c.title }}
  </picture>
{% elsif c.featured_image %}{{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: c.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</a>
            <div class="pp-card__body"><h3><a href="{{ c.url }}">{{ block.settings.title | default: c.title }}</a></h3>{% if section.settings.show_count %}<p>{{ c.all_products_count }} {{ section.settings.count_label }}</p>{% endif %}</div>
          </article>
        {% endif %}
      {% endfor %}
    {% else %}
      {% for collection in collections %}
        <article class="pp-card">
          <a class="pp-card__media" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</a>
          <div class="pp-card__body"><h3><a href="{{ collection.url }}">{{ collection.title }}</a></h3>{% if section.settings.show_count %}<p>{{ collection.all_products_count }} {{ section.settings.count_label }}</p>{% endif %}</div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</div></section>
{% schema %}
