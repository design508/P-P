<section class="pp-page-hero"><div class="page-width"><span class="pp-kicker pp-kicker--pink">{{ 'collections.eyebrow' | t }}</span><h1>{{ 'collections.title' | t }}</h1></div></section>
<section class="pp-section"><div class="page-width"><div class="pp-product-grid pp-product-grid--3">{% for collection in collections %}<article class="pp-card"><a class="pp-card__media" href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</a><div class="pp-card__body"><h2><a href="{{ collection.url }}">{{ collection.title }}</a></h2><p>{{ collection.description | strip_html | truncate: 120 }}</p></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Main collection list","settings":[]}{% endschema %}
