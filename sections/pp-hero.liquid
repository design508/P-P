{% render 'section-editor-styles', section: section %}
<section class="pp-hero" style="--hero-start:{{ section.settings.background_start }};--hero-end:{{ section.settings.background_end }};--hero-height:{{ section.settings.min_height }}px;--badge-bg:{{ section.settings.badge_background }};--badge-text:{{ section.settings.badge_text_color }};--badge-border:{{ section.settings.badge_border_color }}">
  <div class="pp-hero__glow"></div>
  <div class="page-width pp-hero__grid">
    <div class="pp-hero__copy">
      <div class="pp-kicker">{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading | newline_to_br }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="pp-actions">
        {% if section.settings.primary_label != blank %}<a class="pp-btn pp-btn--purple" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }} {% render 'icon-arrow' %}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="pp-btn pp-btn--outline" href="{{ section.settings.secondary_link | default: '/collections/grooming' }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
      <div class="pp-trust">
        {% if section.settings.trust_1 != blank %}<span>{{ section.settings.trust_1 }}</span>{% endif %}
        {% if section.settings.trust_2 != blank %}<span>{{ section.settings.trust_2 }}</span>{% endif %}
        {% if section.settings.trust_3 != blank %}<span>{{ section.settings.trust_3 }}</span>{% endif %}
      </div>
    </div>
    <style>
      {% for i in (1..3) %}
        {% capture k_fit %}image_{{ i }}_fit{% endcapture %}
        {% capture k_position %}image_{{ i }}_position{% endcapture %}
        {% capture k_fit_m %}image_{{ i }}_fit_mobile{% endcapture %}
        {% capture k_position_m %}image_{{ i }}_position_mobile{% endcapture %}
        {% capture k_radius %}image_{{ i }}_radius{% endcapture %}
        {% capture k_radius_m %}image_{{ i }}_radius_mobile{% endcapture %}
        {% capture k_w %}image_{{ i }}_max_width{% endcapture %}
        {% capture k_h %}image_{{ i }}_max_height{% endcapture %}
        {% capture k_w_m %}image_{{ i }}_max_width_mobile{% endcapture %}
        {% capture k_h_m %}image_{{ i }}_max_height_mobile{% endcapture %}
        {% capture k_ha %}image_{{ i }}_h_align{% endcapture %}
        {% capture k_va %}image_{{ i }}_v_align{% endcapture %}
        {% capture k_ha_m %}image_{{ i }}_h_align_mobile{% endcapture %}
        {% capture k_va_m %}image_{{ i }}_v_align_mobile{% endcapture %}
        {% assign fit = section.settings[k_fit] | default: 'contain' %}
        {% assign position = section.settings[k_position] | default: 'center center' %}
        {% assign fit_m = section.settings[k_fit_m] | default: 'contain' %}
        {% assign position_m = section.settings[k_position_m] | default: 'center center' %}
        {% assign radius = section.settings[k_radius] | default: 0 %}
        {% assign radius_m = section.settings[k_radius_m] | default: 0 %}
        {% assign w = section.settings[k_w] | default: 0 %}
        {% assign h = section.settings[k_h] | default: 0 %}
        {% assign w_m = section.settings[k_w_m] | default: 0 %}
        {% assign h_m = section.settings[k_h_m] | default: 0 %}
        {% assign ha = section.settings[k_ha] | default: 'default' %}
        {% assign va = section.settings[k_va] | default: 'default' %}
        {% assign ha_m = section.settings[k_ha_m] | default: 'default' %}
        {% assign va_m = section.settings[k_va_m] | default: 'default' %}
        @media (min-width: 991px) {
          #shopify-section-{{ section.id }} .pp-hero__product--{{ i }} img { object-fit: {{ fit }}; object-position: {{ position }}; {% if w > 0 or h > 0 %}width: 100%; height: 100%; max-width: none; max-height: none;{% endif %} }
          #shopify-section-{{ section.id }} .pp-hero__product--{{ i }} {
            {% if radius > 0 %}border-radius: {{ radius }}px; overflow: hidden;{% endif %}
            {% if w > 0 %}width: min({{ w }}px, 100%); max-width: 100%;{% endif %}
            {% if h > 0 %}height: min({{ h }}px, 100%); max-height: 100%;{% endif %}
            {% if ha == 'left' %}left: 0; right: auto; margin-left: 0; margin-right: 0;{% endif %}
            {% if ha == 'center' %}left: 0; right: 0; margin-left: auto; margin-right: auto;{% endif %}
            {% if ha == 'right' %}left: auto; right: 0; margin-left: 0; margin-right: 0;{% endif %}
            {% if va == 'top' %}top: 0; bottom: auto; margin-top: 0; margin-bottom: 0;{% endif %}
            {% if va == 'center' %}top: 0; bottom: 0; margin-top: auto; margin-bottom: auto;{% endif %}
            {% if va == 'bottom' %}bottom: 0; top: auto; margin-top: 0; margin-bottom: 0;{% endif %}
          }
        }
        @media (max-width: 990px) {
          #shopify-section-{{ section.id }} .pp-hero__product--{{ i }} img { object-fit: {{ fit_m }}; object-position: {{ position_m }}; {% if w_m > 0 or h_m > 0 %}width: 100%; height: 100%; max-width: none; max-height: none;{% endif %} }
          #shopify-section-{{ section.id }} .pp-hero__product--{{ i }} {
            {% if radius_m > 0 %}border-radius: {{ radius_m }}px; overflow: hidden;{% endif %}
            {% if w_m > 0 %}width: min({{ w_m }}px, 100%); max-width: 100%;{% endif %}
            {% if h_m > 0 %}height: min({{ h_m }}px, 100%); max-height: 100%;{% endif %}
            {% if ha_m == 'left' %}left: 0; right: auto; margin-left: 0; margin-right: 0;{% endif %}
            {% if ha_m == 'center' %}left: 0; right: 0; margin-left: auto; margin-right: auto;{% endif %}
            {% if ha_m == 'right' %}left: auto; right: 0; margin-left: 0; margin-right: 0;{% endif %}
            {% if va_m == 'top' %}top: 0; bottom: auto; margin-top: 0; margin-bottom: 0;{% endif %}
            {% if va_m == 'center' %}top: 0; bottom: 0; margin-top: auto; margin-bottom: auto;{% endif %}
            {% if va_m == 'bottom' %}bottom: 0; top: auto; margin-top: 0; margin-bottom: 0;{% endif %}
          }
        }
      {% endfor %}
    </style>
    <div class="pp-hero__products" aria-label="Featured pet care products">
      {% for i in (1..3) %}
        {% capture image_id %}image_{{ i }}{% endcapture %}
        {% capture image_mobile_id %}image_{{ i }}_mobile{% endcapture %}
        {% capture link_id %}image_link_{{ i }}{% endcapture %}
        {% assign image = section.settings[image_id] %}
        {% assign image_mobile = section.settings[image_mobile_id] %}
        {% assign image_display = image | default: image_mobile %}
        {% assign image_link = section.settings[link_id] %}
        {% if image_display != blank %}
          <a {% if image_link != blank %}href="{{ image_link }}"{% endif %} class="pp-hero__product pp-hero__product--{{ i }}">
            <picture>
              {% if image_mobile != blank and image_mobile != image %}
                <source media="(max-width: 990px)" srcset="{{ image_mobile | image_url: width: 300 }} 300w, {{ image_mobile | image_url: width: 450 }} 450w, {{ image_mobile | image_url: width: 600 }} 600w" sizes="280px">
              {% endif %}
              {{ image_display | image_url: width: 900 | image_tag: loading: 'eager', widths: '360,540,720,900', alt: image_display.alt | default: section.settings.heading }}
            </picture>
          </a>
        {% else %}
          <div class="pp-hero__product pp-hero__product--{{ i }} pp-hero__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
        {% endif %}
      {% endfor %}
      {% if section.settings.show_badge and section.settings.badge_text != blank %}<div class="pp-badge-round">{{ section.settings.badge_text | newline_to_br }}</div>{% endif %}
    </div>
  </div>
</section>
