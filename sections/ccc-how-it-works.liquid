{% comment %} Creator Club — How It Works. Classes: pp-ccc-how* {% endcomment %}
{% render 'section-editor-styles', section: section %}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-how {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-how h2 {
    font-family: var(--display);
    font-weight: 800;
    text-align: center;
    font-size: clamp(28px, 3.4vw, 42px);
    color: var(--ink, #351042);
    margin: 0 0 40px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__card {
    background: #fff;
    border: 1px solid var(--line, #eee0ee);
    border-radius: 24px;
    padding: 32px 26px;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 10px 30px -18px rgba(53,16,66,.18);
    transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease;
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -18px rgba(53,16,66,.28);
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__icon {
    width: 56px; height: 56px;
    border-radius: 16px;
    display: grid; place-items: center;
    background: {{ section.settings.icon_bg }};
    margin-bottom: 18px;
    transition: transform .35s cubic-bezier(.34,1.56,.64,1);
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__card:hover .pp-ccc-how__icon {
    transform: rotate(-8deg) scale(1.08);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-ccc-how__card,
    #shopify-section-{{ section.id }} .pp-ccc-how__icon { transition: none; }
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__icon img { width: 32px; height: 32px; object-fit: contain; }
  #shopify-section-{{ section.id }} .pp-ccc-how__icon svg { width: 30px; height: 30px; stroke: {{ section.settings.icon_color }}; fill: none; }
  #shopify-section-{{ section.id }} .pp-ccc-how__step {
    font-family: var(--body);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: .12em;
    color: {{ section.settings.accent_color }};
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__card h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    color: var(--ink, #351042);
    margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__card p {
    font-family: var(--body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted, #6b5b73);
    margin: 0;
  }
  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .pp-ccc-how__grid { grid-template-columns: 1fr; }
  }
  /* Candy colours: each of the 3 cards gets its own icon tint instead of
     sharing one colour, and the step label pops in with a little bounce
     once the section scrolls into view (reuses the site-wide .pp-reveal /
     .is-visible mechanism already on this section, no new JS). */
  #shopify-section-{{ section.id }} .pp-ccc-how__grid > .pp-ccc-how__card:nth-child(3n+2) .pp-ccc-how__icon {
    background: color-mix(in srgb, var(--pink, #ff2b78) 18%, white);
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__grid > .pp-ccc-how__card:nth-child(3n+3) .pp-ccc-how__icon {
    background: color-mix(in srgb, var(--green, #61f46f) 30%, white);
  }
  #shopify-section-{{ section.id }} .pp-ccc-how__step { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-how.is-visible .pp-ccc-how__grid > .pp-ccc-how__card:nth-child(1) .pp-ccc-how__step {
      animation: pp-ccc-step-pop .5s cubic-bezier(.34,1.56,.64,1) .15s both;
    }
    #shopify-section-{{ section.id }} .pp-ccc-how.is-visible .pp-ccc-how__grid > .pp-ccc-how__card:nth-child(2) .pp-ccc-how__step {
      animation: pp-ccc-step-pop .5s cubic-bezier(.34,1.56,.64,1) .3s both;
    }
    #shopify-section-{{ section.id }} .pp-ccc-how.is-visible .pp-ccc-how__grid > .pp-ccc-how__card:nth-child(3) .pp-ccc-how__step {
      animation: pp-ccc-step-pop .5s cubic-bezier(.34,1.56,.64,1) .45s both;
    }
  }
  @keyframes pp-ccc-step-pop {
    0% { transform: scale(.4); opacity: 0; }
    70% { transform: scale(1.15); opacity: 1; }
    100% { transform: scale(1); }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-how__step { animation: none !important; }
</style>
<section class="pp-ccc-how pp-reveal" id="ccc-how-it-works">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    <div class="pp-ccc-how__grid">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="pp-ccc-how__card" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            {% assign icon_image_img = block.settings.icon_image %}
{% assign icon_image_img_mobile = block.settings.icon_image_mobile %}
{% assign icon_image_display = icon_image_img | default: icon_image_img_mobile %}
{% assign icon_image_fit = block.settings.icon_image_fit | default: 'contain' %}
{% assign icon_image_position = block.settings.icon_image_position | default: 'center center' %}
{% assign icon_image_fit_m = block.settings.icon_image_fit_mobile | default: 'contain' %}
{% assign icon_image_position_m = block.settings.icon_image_position_mobile | default: 'center center' %}
{% assign icon_image_radius = block.settings.icon_image_radius | default: 0 %}
{% assign icon_image_radius_m = block.settings.icon_image_radius_mobile | default: 0 %}
{% assign icon_image_w = block.settings.icon_image_max_width | default: 0 %}
{% assign icon_image_h = block.settings.icon_image_max_height | default: 0 %}
{% assign icon_image_w_m = block.settings.icon_image_max_width_mobile | default: 0 %}
{% assign icon_image_h_m = block.settings.icon_image_max_height_mobile | default: 0 %}
{% assign icon_image_ha = block.settings.icon_image_h_align | default: 'default' %}
{% assign icon_image_va = block.settings.icon_image_v_align | default: 'default' %}
{% assign icon_image_ha_m = block.settings.icon_image_h_align_mobile | default: 'default' %}
{% assign icon_image_va_m = block.settings.icon_image_v_align_mobile | default: 'default' %}
            <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-ccc-how__card[data-pp-block-id="{{ block.id }}"] .pp-ccc-how__icon img { object-fit: {{ icon_image_fit }}; object-position: {{ icon_image_position }}; }
  #shopify-section-{{ section.id }} .pp-ccc-how__card[data-pp-block-id="{{ block.id }}"] .pp-ccc-how__icon {
    {% if icon_image_radius > 0 %}border-radius: {{ icon_image_radius }}px; overflow: hidden;{% endif %}
    {% if icon_image_w > 0 %}width: min({{ icon_image_w }}px, 100%); max-width: 100%;{% endif %}
    {% if icon_image_h > 0 %}height: min({{ icon_image_h }}px, 100%); max-height: 100%;{% endif %}
    {% if icon_image_ha == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if icon_image_ha == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if icon_image_ha == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if icon_image_va == 'top' %}align-self: flex-start;{% endif %}
    {% if icon_image_va == 'center' %}align-self: center;{% endif %}
    {% if icon_image_va == 'bottom' %}align-self: flex-end;{% endif %}
  }
}
@media (max-width: 990px) {
  #shopify-section-{{ section.id }} .pp-ccc-how__card[data-pp-block-id="{{ block.id }}"] .pp-ccc-how__icon img { object-fit: {{ icon_image_fit_m }}; object-position: {{ icon_image_position_m }}; }
  #shopify-section-{{ section.id }} .pp-ccc-how__card[data-pp-block-id="{{ block.id }}"] .pp-ccc-how__icon {
    {% if icon_image_radius_m > 0 %}border-radius: {{ icon_image_radius_m }}px; overflow: hidden;{% endif %}
    {% if icon_image_w_m > 0 %}width: min({{ icon_image_w_m }}px, 100%); max-width: 100%;{% endif %}
    {% if icon_image_h_m > 0 %}height: min({{ icon_image_h_m }}px, 100%); max-height: 100%;{% endif %}
    {% if icon_image_ha_m == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if icon_image_ha_m == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if icon_image_ha_m == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if icon_image_va_m == 'top' %}align-self: flex-start;{% endif %}
    {% if icon_image_va_m == 'center' %}align-self: center;{% endif %}
    {% if icon_image_va_m == 'bottom' %}align-self: flex-end;{% endif %}
  }
}</style>
            <div class="pp-ccc-how__icon">
              {% if icon_image_display != blank %}
  <picture>
    {% if icon_image_img_mobile != blank and icon_image_img_mobile != icon_image_img %}
      <source media="(max-width: 990px)" srcset="{{ icon_image_img_mobile | image_url: width: 400 }} 400w, {{ icon_image_img_mobile | image_url: width: 600 }} 600w, {{ icon_image_img_mobile | image_url: width: 800 }} 800w, {{ icon_image_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ icon_image_display | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
  </picture>
              {% else %}
                {% case block.settings.icon %}
                  {% when 'unbox' %}
                    <svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9-4 9 4-9 4-9-4Z"/><path d="M3 8v8l9 4 9-4V8"/><path d="M12 12v8"/></svg>
                  {% when 'camera' %}
                    <svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-2h6l2 2h3v11H4Z"/><circle cx="12" cy="13" r="3.2"/></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 8.5c0-2-1.6-3.5-3.5-3.5-1.3 0-2.4.7-3 1.8L12 8l-1.5-1.2c-.6-1.1-1.7-1.8-3-1.8C5.6 5 4 6.5 4 8.5 4 13 12 18 12 18s8-5 8-9.5Z"/></svg>
                {% endcase %}
              {% endif %}
            </div>
            <span class="pp-ccc-how__step">{{ block.settings.step_label }}</span>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
