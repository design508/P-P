{% render 'section-editor-styles', section: section %}
{{ 'pp-pdp-recos-life.css' | asset_url | stylesheet_tag }}
<section class="pp-section pp-recos" style="background:{{ section.settings.background }}">
  <div class="page-width">
    <div class="pp-products__head"><div><div class="pp-kicker pp-kicker--pink">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.show_link and product.collections.first %}<a class="pp-text-link" href="{{ product.collections.first.url }}">{{ section.settings.link_label }} {% render 'icon-arrow' %}</a>{% endif %}</div>
    <div class="pp-product-grid pp-product-grid--3">
      {% assign shown = 0 %}
      {% assign care_guide = product.metafields.custom.care_guide.value %}
      {% if care_guide != blank and care_guide.related_products.value != blank %}
        {% for related in care_guide.related_products.value %}
          {% unless related.id == product.id %}{% render 'product-card', product: related, eyebrow: section.settings.card_eyebrow %}{% assign shown = shown | plus: 1 %}{% if shown >= section.settings.products_to_show %}{% break %}{% endif %}{% endunless %}
        {% endfor %}
      {% endif %}
      {% if shown < section.settings.products_to_show and product.collections.first %}
        {% for related in product.collections.first.products %}
          {% unless related.id == product.id %}
            {% assign already_related = false %}{% if care_guide != blank and care_guide.related_products.value != blank %}{% for linked in care_guide.related_products.value %}{% if linked.id == related.id %}{% assign already_related = true %}{% endif %}{% endfor %}{% endif %}
            {% unless already_related %}{% render 'product-card', product: related, eyebrow: section.settings.card_eyebrow %}{% assign shown = shown | plus: 1 %}{% endunless %}{% if shown >= section.settings.products_to_show %}{% break %}{% endif %}
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
