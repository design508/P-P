<section class="pp-section pp-recos product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"><div class="page-width">{% if recommendations.performed? and recommendations.products_count > 0 %}<header class="pp-section__head"><div><span class="pp-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.show_link %}<a href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>{% endif %}</header><div class="pp-product-grid pp-product-grid--3">{% for recommended_product in recommendations.products limit: section.settings.products_to_show %}{% render 'product-card', product: recommended_product, eyebrow: section.settings.card_eyebrow %}{% endfor %}</div>{% endif %}</div></section>
{% javascript %}document.querySelectorAll('.product-recommendations').forEach(function(section){if(section.dataset.loaded)return;var observer=new IntersectionObserver(function(entries){if(!entries[0].isIntersecting)return;observer.disconnect();fetch(section.dataset.url).then(function(response){return response.text()}).then(function(text){var html=document.createElement('div');html.innerHTML=text;var replacement=html.querySelector('.product-recommendations');if(replacement)section.innerHTML=replacement.innerHTML;section.dataset.loaded='true'})},{rootMargin:'0px 0px 300px 0px'});observer.observe(section)});{% endjavascript %}
{% schema %}
{"name":"Product recommendations","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading","default":"You may also like"},{"type":"checkbox","id":"show_link","label":"Show collection link","default":true},{"type":"text","id":"link_label","label":"Link label"},{"type":"text","id":"card_eyebrow","label":"Card eyebrow"},{"type":"range","id":"products_to_show","label":"Products","min":2,"max":4,"step":1,"default":3},{"type":"color","id":"background","label":"Background","default":"#ffffff"}]}
{% endschema %}
