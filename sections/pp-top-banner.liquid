{% comment %}
  Site-wide optional banner, rendered from sections/header-group.json so it
  appears on every page, directly below the header (see layout/theme.liquid's
  {% sections 'header-group' %} call). Fully optional: renders nothing unless
  the merchant adds an image and/or text.

  - Image only: the section's height follows the image's own aspect ratio
    (no fixed-height crop).
  - Text only: a simple padded band, background colour + full text controls.
  - Image + text: text overlays the image (image becomes the background).
{% endcomment %}

{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  assign has_text = false
  if section.settings.heading != blank or section.settings.text != blank
    assign has_text = true
  endif

  assign show_banner = false
  if section.settings.enable and has_image
    assign show_banner = true
  elsif section.settings.enable and has_text
    assign show_banner = true
  endif

  assign overlay_alpha = section.settings.overlay_opacity | times: 1.0 | divided_by: 100.0
-%}

{%- if show_banner -%}

  <div class="pp-top-banner{% if has_image %} pp-top-banner--has-image{% endif %}{% if has_image and has_text %} pp-top-banner--overlay{% endif %}">

    {%- if section.settings.link != blank -%}<a class="pp-top-banner__link" href="{{ section.settings.link }}">{%- endif -%}

    <div class="pp-top-banner__inner">

      {%- if has_image -%}
        <picture class="pp-top-banner__picture">
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1500 }}">
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 3000
            | image_tag:
              loading: 'eager',
              widths: '480,768,1024,1440,1920,2560,3000',
              class: 'pp-top-banner__image',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        </picture>
      {%- endif -%}

      {%- if has_text -%}
        <div class="pp-top-banner__content">
          {%- if section.settings.heading != blank -%}
            <h2 class="pp-top-banner__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="pp-top-banner__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <span class="pp-btn pp-btn--{{ section.settings.button_style }} pp-top-banner__btn">
              {{ section.settings.button_label }}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

    {%- if section.settings.link != blank -%}</a>{%- endif -%}

  </div>


  <style>

    {% liquid
      assign tb_fit = section.settings.image_fit | default: 'cover'
      assign tb_position = section.settings.image_position | default: 'center center'
      assign tb_height = section.settings.image_height | default: 0
      assign tb_radius = section.settings.image_radius | default: 0
      assign tb_fit_m = section.settings.image_fit_mobile | default: 'cover'
      assign tb_position_m = section.settings.image_position_mobile | default: 'center center'
      assign tb_height_m = section.settings.image_height_mobile | default: 0
      assign tb_radius_m = section.settings.image_radius_mobile | default: 0
    %}
    {% if tb_height > 0 %}
      #shopify-section-{{ section.id }} .pp-top-banner__picture,
      #shopify-section-{{ section.id }} .pp-top-banner__image {
        height: {{ tb_height }}px;
      }
      #shopify-section-{{ section.id }} .pp-top-banner__image {
        width: 100%;
        object-fit: {{ tb_fit }};
        object-position: {{ tb_position }};
      }
    {% endif %}
    {% if tb_radius > 0 %}
      #shopify-section-{{ section.id }} .pp-top-banner__picture { border-radius: {{ tb_radius }}px; overflow: hidden; }
    {% endif %}
    @media screen and (max-width: 749px) {
      {% if tb_height_m > 0 %}
        #shopify-section-{{ section.id }} .pp-top-banner__picture,
        #shopify-section-{{ section.id }} .pp-top-banner__image {
          height: {{ tb_height_m }}px;
        }
        #shopify-section-{{ section.id }} .pp-top-banner__image {
          width: 100%;
          object-fit: {{ tb_fit_m }};
          object-position: {{ tb_position_m }};
        }
      {% endif %}
      {% if tb_radius_m > 0 %}
        #shopify-section-{{ section.id }} .pp-top-banner__picture { border-radius: {{ tb_radius_m }}px; overflow: hidden; }
      {% endif %}
    }

    #shopify-section-{{ section.id }} .pp-top-banner {
      position: relative;
      width: 100%;
      overflow: hidden;
      background: {{ section.settings.background_color }};
    }

    #shopify-section-{{ section.id }} .pp-top-banner__link {
      display: block;
      color: inherit;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} .pp-top-banner__inner {
      position: relative;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .pp-top-banner__picture,
    #shopify-section-{{ section.id }} .pp-top-banner__image {
      display: block;
      width: 100%;
      height: auto;
    }

    /* Text-only band: no image, so height comes from padding + content. */
    #shopify-section-{{ section.id }} .pp-top-banner:not(.pp-top-banner--has-image) .pp-top-banner__inner {
      padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    }

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .pp-top-banner:not(.pp-top-banner--has-image) .pp-top-banner__inner {
        padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
      }
    }

    /* Image + text together: text overlays on top of the image. */
    #shopify-section-{{ section.id }} .pp-top-banner--overlay .pp-top-banner__inner {
      display: grid;
    }

    #shopify-section-{{ section.id }} .pp-top-banner--overlay .pp-top-banner__picture {
      grid-area: 1 / 1;
    }

    #shopify-section-{{ section.id }} .pp-top-banner--overlay .pp-top-banner__content {
      grid-area: 1 / 1;
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 24px clamp(20px, 5vw, 64px);
    }

    #shopify-section-{{ section.id }} .pp-top-banner--overlay .pp-top-banner__content:before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_alpha }};
    }

    #shopify-section-{{ section.id }} .pp-top-banner__content {
      text-align: {{ section.settings.text_align }};
    }

    #shopify-section-{{ section.id }} .pp-top-banner--overlay .pp-top-banner__content {
      align-items: {% case section.settings.text_align %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
    }

    #shopify-section-{{ section.id }} .pp-top-banner__heading {
      font-family: {% case section.settings.heading_font %}{% when 'aquatail' %}'PP Aquatail', Georgia, serif{% when 'futura' %}'PP Futura', Arial, sans-serif{% else %}var(--display){% endcase %};
      font-weight: {{ section.settings.heading_weight }};
      font-size: clamp({{ section.settings.heading_size_mobile }}px, {{ section.settings.heading_size | divided_by: 20.0 }}vw, {{ section.settings.heading_size }}px);
      letter-spacing: {{ section.settings.heading_tracking | divided_by: 100.0 }}em;
      color: {{ section.settings.heading_color }};
      line-height: 1.05;
      margin: 0 0 12px;
    }

    #shopify-section-{{ section.id }} .pp-top-banner__text {
      font-family: {% case section.settings.body_font %}{% when 'aquatail' %}'PP Aquatail', Georgia, serif{% when 'futura' %}'PP Futura', Arial, sans-serif{% else %}var(--body){% endcase %};
      font-weight: {{ section.settings.body_weight }};
      font-size: clamp({{ section.settings.body_size_mobile }}px, {{ section.settings.body_size | divided_by: 20.0 }}vw, {{ section.settings.body_size }}px);
      color: {{ section.settings.text_color }};
      margin: 0 0 16px;
    }

    #shopify-section-{{ section.id }} .pp-top-banner__text:last-child,
    #shopify-section-{{ section.id }} .pp-top-banner__heading:last-child {
      margin-bottom: 0;
    }

    #shopify-section-{{ section.id }} .pp-top-banner__btn {
      align-self: {% case section.settings.text_align %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
    }

  </style>

{%- endif -%}

{% schema %}
{
  "name": "Top banner",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable this banner",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image — mobile (optional)",
      "info": "Shown at 749px and narrower. Leave empty to use the same image on mobile."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "How the image fills its height — desktop",
      "info": "Only matters when a fixed banner height below is set; otherwise the image keeps its natural proportions.",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill the banner completely (may crop)" },
        { "value": "contain", "label": "Show the whole image (may letterbox)" }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image alignment — desktop",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "right center", "label": "Middle right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 0,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Fixed banner height — desktop (0 = automatic)",
      "info": "0 keeps the image's natural proportions (recommended for a full-width banner).",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Corner rounding — desktop (0 = theme default)",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_fit_mobile",
      "label": "How the image fills its height — mobile",
      "info": "Only matters when a fixed banner height below is set; otherwise the image keeps its natural proportions.",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Fill the banner completely (may crop)" },
        { "value": "contain", "label": "Show the whole image (may letterbox)" }
      ]
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image alignment — mobile",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Middle left" },
        { "value": "center center", "label": "Middle center" },
        { "value": "right center", "label": "Middle right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "min": 0,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Fixed banner height — mobile (0 = automatic)",
      "info": "0 keeps the image's natural proportions (recommended for a full-width banner).",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_radius_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Corner rounding — mobile (0 = theme default)",
      "default": 0
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional, wraps the whole banner)"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (optional)"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "purple", "label": "Purple" },
        { "value": "orange", "label": "Orange" },
        { "value": "green", "label": "Green" },
        { "value": "white", "label": "White" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "purple"
    },
    {
      "type": "header",
      "content": "Text styling — heading"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        { "value": "theme", "label": "Theme heading font" },
        { "value": "aquatail", "label": "PP Aquatail" },
        { "value": "futura", "label": "PP Futura" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extrabold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "800"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Heading size — desktop",
      "default": 42
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading size — mobile",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_tracking",
      "min": -5,
      "max": 5,
      "step": 0.5,
      "label": "Heading letter spacing",
      "default": -1
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#351042"
    },
    {
      "type": "header",
      "content": "Text styling — body"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Body font",
      "options": [
        { "value": "theme", "label": "Theme body font" },
        { "value": "aquatail", "label": "PP Aquatail" },
        { "value": "futura", "label": "PP Futura" }
      ],
      "default": "theme"
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body size — desktop",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body size — mobile",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#351042"
    },
    {
      "type": "header",
      "content": "Background & overlay"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color (text-only banner)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color (image + text)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 25
    },
    {
      "type": "header",
      "content": "Spacing (text-only banner)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding — desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding — desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding — mobile",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding — mobile",
      "default": 24
    }
  ]
}
{% endschema %}
