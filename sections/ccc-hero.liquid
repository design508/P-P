{% comment %}
  Creator Club — Hero
  Namespaced classes: pp-ccc-hero*
{% endcomment %}
{% render 'section-editor-styles', section: section %}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-hero {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    isolation: isolate;
  }
  /* Playful soft colour blobs drifting behind the hero content. */
  #shopify-section-{{ section.id }} .pp-ccc-hero:before,
  #shopify-section-{{ section.id }} .pp-ccc-hero:after {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    filter: blur(55px);
    opacity: .32;
    z-index: 0;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero:before {
    background: {{ section.settings.accent_color }};
    top: -90px;
    left: -70px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero:after {
    background: var(--orange, #ff5a0a);
    width: 340px;
    height: 340px;
    bottom: -120px;
    right: -90px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__grid {
    position: relative;
    z-index: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-hero:before { animation: pp-ccc-blob-drift 9s ease-in-out infinite; }
    #shopify-section-{{ section.id }} .pp-ccc-hero:after { animation: pp-ccc-blob-drift 11s ease-in-out infinite reverse; }
  }
  @keyframes pp-ccc-blob-drift {
    0%, 100% { transform: translate(0,0) scale(1); }
    50% { transform: translate(22px,-16px) scale(1.08); }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-hero:before,
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-hero:after { animation: none !important; }
  /* Confetti pieces spawned by pp-creator-club.js on scroll-cue click.
     Unscoped (no #shopify-section-… prefix) so the same class also works
     for the reward-tiers hover burst spawned elsewhere on this page. */
  .pp-confetti-piece {
    position: fixed;
    top: 0;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    pointer-events: none;
    z-index: 9999;
    opacity: 1;
    transform: translate(-50%, -50%);
    animation: pp-confetti-pop .8s cubic-bezier(.2,.7,.3,1) forwards;
  }
  @keyframes pp-confetti-pop {
    0% { transform: translate(-50%,-50%) translate(0,0) rotate(0deg) scale(1); opacity: 1; }
    100% { transform: translate(-50%,-50%) translate(var(--pp-confetti-dx,40px),var(--pp-confetti-dy,-40px)) rotate(var(--pp-confetti-rot,90deg)) scale(.4); opacity: 0; }
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__grid {
    display: grid;
    grid-template-columns: minmax(0,1.05fr) minmax(0,0.95fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--body);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: .14em;
    color: {{ section.settings.accent_color }};
    background: {{ section.settings.eyebrow_bg }};
    padding: 8px 16px;
    border-radius: 999px;
    margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero h1 {
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.02;
    font-size: clamp(38px, 5.2vw, 68px);
    color: {{ section.settings.heading_color }};
    margin: 0 0 20px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero p.pp-ccc-hero__text {
    font-family: var(--body);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.6;
    color: var(--muted, #6b5b73);
    max-width: 46ch;
    margin: 0 0 30px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 22px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__reassure {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--body);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink, #351042);
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__reassure:before {
    content: "🐾";
    font-size: 16px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__squiggle {
    display: block;
    width: clamp(140px, 18vw, 220px);
    height: 18px;
    margin: -8px 0 22px;
    overflow: visible;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__squiggle path {
    stroke: {{ section.settings.accent_color }};
    stroke-width: 4;
    stroke-linecap: round;
    fill: none;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    transition: stroke-dashoffset 1.1s cubic-bezier(.2,.7,.2,1) .45s;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero.is-visible .pp-ccc-hero__squiggle path,
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-hero__squiggle path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-ccc-hero__squiggle path { stroke-dashoffset: 0; transition: none; }
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__roadmap {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 4px 0 26px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #fff;
    border: 1px solid color-mix(in srgb, {{ section.settings.accent_color }} 22%, white);
    color: var(--ink, #351042);
    font-family: var(--body);
    font-weight: 700;
    font-size: 12.5px;
    padding: 9px 14px;
    border-radius: 999px;
    box-shadow: 0 8px 20px -14px rgba(53,16,66,.35);
    transition: transform .22s ease, box-shadow .22s ease, background .22s ease;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__chip span:first-child {
    font-size: 15px;
    display: inline-block;
    transition: transform .3s ease;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__chip:hover {
    transform: translateY(-3px);
    background: {{ section.settings.eyebrow_bg }};
    box-shadow: 0 14px 26px -14px rgba(53,16,66,.4);
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__chip:hover span:first-child {
    transform: rotate(-12deg) scale(1.15);
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__scrollcue {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--muted, #6b5b73);
    font-family: var(--body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: uppercase;
    z-index: 3;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__scrollcue span.pp-ccc-hero__chevron {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, {{ section.settings.accent_color }} 35%, white);
    display: grid; place-items: center;
    font-size: 15px;
    color: {{ section.settings.accent_color }};
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-hero__scrollcue span.pp-ccc-hero__chevron { animation: pp-ccc-cue-bounce 1.8s ease-in-out infinite; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__paw { animation: pp-ccc-paw-sway 6.5s ease-in-out infinite; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__paw--b { animation-duration: 7.4s; animation-delay: .5s; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__paw--c { animation-duration: 8.1s; animation-delay: 1s; }
    @keyframes pp-ccc-cue-bounce { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(6px);} }
    @keyframes pp-ccc-paw-sway { 0%,100%{ transform: rotate(var(--r,0deg)) translateY(0);} 50%{ transform: rotate(calc(var(--r,0deg) + 8deg)) translateY(-5px);} }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-hero__scrollcue span.pp-ccc-hero__chevron,
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-hero__paw { animation: none !important; }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .pp-ccc-hero__squiggle { margin-left: auto; margin-right: auto; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__roadmap { justify-content: center; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__scrollcue { display: none; }
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__visual {
    position: relative;
    min-height: 340px;
    display: grid;
    place-items: center;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 480px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__main {
    position: absolute;
    inset: 6% 10%;
    border-radius: 32px;
    overflow: hidden;
    background: {{ section.settings.visual_bg }};
    box-shadow: 0 24px 60px -20px rgba(53,16,66,.25);
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__main img,
  #shopify-section-{{ section.id }} .pp-ccc-hero__main svg {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__peek {
    position: absolute;
    width: 34%;
    aspect-ratio: 1/1;
    border-radius: 50%;
    overflow: hidden;
    border: 5px solid #fff;
    box-shadow: 0 14px 30px -10px rgba(53,16,66,.3);
    background: #fff;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__peek img { width:100%; height:100%; object-fit:cover; display:block; }
  #shopify-section-{{ section.id }} .pp-ccc-hero__peek--1 { top: -4%; right: -6%; }
  #shopify-section-{{ section.id }} .pp-ccc-hero__peek--2 { bottom: -6%; left: -8%; width: 30%; }
  #shopify-section-{{ section.id }} .pp-ccc-hero__paw {
    position: absolute;
    font-size: 22px;
    opacity: .35;
    transform: rotate(var(--r, 0deg));
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .pp-ccc-hero__paw--a { top: 6%; left: 2%; --r: -18deg; }
  #shopify-section-{{ section.id }} .pp-ccc-hero__paw--b { bottom: 12%; right: 4%; --r: 14deg; font-size: 28px; }
  #shopify-section-{{ section.id }} .pp-ccc-hero__paw--c { top: 45%; left: -2%; --r: 8deg; font-size: 18px; }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-hero__peek { animation: pp-ccc-bob 5.5s ease-in-out infinite; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__peek--2 { animation-delay: .6s; }
    @keyframes pp-ccc-bob { 0%,100%{ transform: translateY(0);} 50%{ transform: translateY(-8px);} }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-hero__peek { animation: none !important; }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .pp-ccc-hero__grid { grid-template-columns: 1fr; text-align: center; }
    #shopify-section-{{ section.id }} .pp-ccc-hero p.pp-ccc-hero__text { max-width: 100%; margin-left:auto; margin-right:auto; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__actions, #shopify-section-{{ section.id }} .pp-ccc-hero__reassure { justify-content: center; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__visual { min-height: 280px; margin-top: 12px; }
    #shopify-section-{{ section.id }} .pp-ccc-hero__stage { max-width: 320px; }
  }
</style>

<section class="pp-ccc-hero pp-reveal" id="ccc-hero">
  <div class="page-width">
    <div class="pp-ccc-hero__grid">
      <div class="pp-ccc-hero__content">
        {% if section.settings.eyebrow != blank %}
          <span class="pp-ccc-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h1>{{ section.settings.heading }}</h1>
        {% if section.settings.squiggle_enable %}
          <svg class="pp-ccc-hero__squiggle" viewBox="0 0 220 18" aria-hidden="true">
            <path d="M2,12 Q20,2 38,12 T74,12 T110,12 T146,12 T182,12 T218,12" />
          </svg>
        {% endif %}
        {% if section.settings.text != blank %}<p class="pp-ccc-hero__text">{{ section.settings.text }}</p>{% endif %}
        <div class="pp-ccc-hero__actions">
          {% if section.settings.primary_label != blank %}
            <a href="#{{ section.settings.primary_target | default: 'creator-club-form' }}" class="pp-btn pp-btn--orange" data-ccc-smooth-scroll>{{ section.settings.primary_label }}</a>
          {% endif %}
          {% if section.settings.secondary_label != blank %}
            <a href="#{{ section.settings.secondary_target | default: 'ccc-how-it-works' }}" class="pp-btn pp-btn--outline" data-ccc-smooth-scroll>{{ section.settings.secondary_label }}</a>
          {% endif %}
        </div>
        {% if section.settings.reassurance != blank %}
          <p class="pp-ccc-hero__reassure">{{ section.settings.reassurance }}</p>
        {% endif %}
        {% if section.settings.roadmap_enable %}
          <div class="pp-ccc-hero__roadmap" aria-label="Jump to a section">
            {% if section.settings.roadmap_1_label != blank %}
              <a href="#{{ section.settings.roadmap_1_target | default: 'ccc-how-it-works' }}" class="pp-ccc-hero__chip" data-ccc-smooth-scroll><span>{{ section.settings.roadmap_1_icon }}</span>{{ section.settings.roadmap_1_label }}</a>
            {% endif %}
            {% if section.settings.roadmap_2_label != blank %}
              <a href="#{{ section.settings.roadmap_2_target | default: 'ccc-rewards' }}" class="pp-ccc-hero__chip" data-ccc-smooth-scroll><span>{{ section.settings.roadmap_2_icon }}</span>{{ section.settings.roadmap_2_label }}</a>
            {% endif %}
            {% if section.settings.roadmap_3_label != blank %}
              <a href="#{{ section.settings.roadmap_3_target | default: 'ccc-ideas' }}" class="pp-ccc-hero__chip" data-ccc-smooth-scroll><span>{{ section.settings.roadmap_3_icon }}</span>{{ section.settings.roadmap_3_label }}</a>
            {% endif %}
            {% if section.settings.roadmap_4_label != blank %}
              <a href="#{{ section.settings.roadmap_4_target | default: 'ccc-faq' }}" class="pp-ccc-hero__chip" data-ccc-smooth-scroll><span>{{ section.settings.roadmap_4_icon }}</span>{{ section.settings.roadmap_4_label }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
      {% assign image_main_img = section.settings.image_main %}
{% assign image_main_img_mobile = section.settings.image_main_mobile %}
{% assign image_main_display = image_main_img | default: image_main_img_mobile %}
