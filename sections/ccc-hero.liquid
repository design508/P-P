      <source media="(max-width: 990px)" srcset="{{ image_main_img_mobile | image_url: width: 400 }} 400w, {{ image_main_img_mobile | image_url: width: 600 }} 600w, {{ image_main_img_mobile | image_url: width: 800 }} 800w, {{ image_main_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ image_main_display | image_url: width: 900 | image_tag: loading: 'eager', widths: '400,600,900', alt: image_main_display.alt | default: 'A Pups & Paws pet parent moment' }}
  </picture>
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'pp-ccc-placeholder' }}
            {% endif %}
          </div>
          {% if image_peek_1_display != blank %}
            <div class="pp-ccc-hero__peek pp-ccc-hero__peek--1">
  <picture>
    {% if image_peek_1_img_mobile != blank and image_peek_1_img_mobile != image_peek_1_img %}
      <source media="(max-width: 990px)" srcset="{{ image_peek_1_img_mobile | image_url: width: 400 }} 400w, {{ image_peek_1_img_mobile | image_url: width: 600 }} 600w, {{ image_peek_1_img_mobile | image_url: width: 800 }} 800w, {{ image_peek_1_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ image_peek_1_display | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,220,300', alt: image_peek_1_display.alt | default: 'Pet peeking' }}
