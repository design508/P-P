    {% if image_main_ha_m == 'center' %}left: 0; right: 0; margin-left: auto; margin-right: auto;{% endif %}
    {% if image_main_ha_m == 'right' %}left: auto; right: 0; margin-left: 0; margin-right: 0;{% endif %}
    {% if image_main_va_m == 'top' %}top: 0; bottom: auto; margin-top: 0; margin-bottom: 0;{% endif %}
    {% if image_main_va_m == 'center' %}top: 0; bottom: 0; margin-top: auto; margin-bottom: auto;{% endif %}
    {% if image_main_va_m == 'bottom' %}bottom: 0; top: auto; margin-top: 0; margin-bottom: 0;{% endif %}
  }
}
@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-ccc-hero__peek--1 img { object-fit: {{ image_peek_1_fit }}; object-position: {{ image_peek_1_position }}; }
  #shopify-section-{{ section.id }} .pp-ccc-hero__peek--1 {
