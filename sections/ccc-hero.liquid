      <div class="pp-ccc-hero__visual" aria-hidden="{% if image_main_display == blank %}true{% else %}false{% endif %}">
        <div class="pp-ccc-hero__stage">
          <span class="pp-ccc-hero__paw pp-ccc-hero__paw--a">🐾</span>
