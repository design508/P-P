      <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-ccc-hero__main img { object-fit: {{ image_main_fit }}; object-position: {{ image_main_position }}; }
  #shopify-section-{{ section.id }} .pp-ccc-hero__main {
    {% if image_main_radius > 0 %}border-radius: {{ image_main_radius }}px; overflow: hidden;{% endif %}
    {% if image_main_w > 0 %}width: min({{ image_main_w }}px, 100%); max-width: 100%;{% endif %}
    {% if image_main_h > 0 %}height: min({{ image_main_h }}px, 100%); max-height: 100%;{% endif %}
    {% if image_main_ha == 'left' %}left: 0; right: auto; margin-left: 0; margin-right: 0;{% endif %}
    {% if image_main_ha == 'center' %}left: 0; right: 0; margin-left: auto; margin-right: auto;{% endif %}
    {% if image_main_ha == 'right' %}left: auto; right: 0; margin-left: 0; margin-right: 0;{% endif %}
    {% if image_main_va == 'top' %}top: 0; bottom: auto; margin-top: 0; margin-bottom: 0;{% endif %}
    {% if image_main_va == 'center' %}top: 0; bottom: 0; margin-top: auto; margin-bottom: auto;{% endif %}
    {% if image_main_va == 'bottom' %}bottom: 0; top: auto; margin-top: 0; margin-bottom: 0;{% endif %}
  }
}
