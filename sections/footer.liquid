{% render 'section-editor-styles', section: section %}
{{ 'pp-footer-parade.css' | asset_url | stylesheet_tag }}
<footer class="pp-footer" style="--footer-bg:{{ section.settings.background }};--footer-text:{{ section.settings.text_color }};--footer-accent:{{ section.settings.accent_color }}">
  <div class="page-width pp-footer__grid">
    <div>
      {% if section.settings.eyebrow != blank %}<div class="pp-kicker pp-kicker--green">{{ section.settings.eyebrow }}</div>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | newline_to_br }}</h2>{% endif %}
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
    {% for block in section.blocks %}
      <div data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
        <div class="pp-kicker pp-kicker--green">{{ block.settings.heading }}</div>
{% if block.settings.menu != blank %}{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% elsif block.settings.heading == 'CARE' %}<a href="/collections/grooming">Grooming</a><a href="/collections/nutrition">Nutrition</a><a href="/collections/treats">Treats</a>{% elsif block.settings.heading == 'SHOP' %}<a href="{{ routes.all_products_collection_url }}">Shop all</a><a href="{{ routes.cart_url }}" data-cart-open>Care bag</a><a href="/pages/our-story">Our story</a><a href="/pages/pet-parent-creator-club#ccc-affiliate">Affiliate Program</a>{% endif %}      </div>
    {% endfor %}
  </div>
  <div class="page-width pp-footer__bottom">
    <span>{% if section.settings.show_year %}© {{ 'now' | date: '%Y' }} {% endif %}{% if section.settings.show_shop_name %}{{ shop.name }}. {% endif %}{{ section.settings.bottom_text }}</span>
    {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
      <div class="pp-footer__payments" aria-label="{{ section.settings.payment_label }}">
        {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}
      </div>
    {% endif %}
  </div>
  {% if section.settings.parade_enable %}
    {% render 'pp-footer-parade', section: section %}
  {% endif %}
</footer>
