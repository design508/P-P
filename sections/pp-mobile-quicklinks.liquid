{% comment %}
  Mobile-only "quick links" strip: two equal, compact, tappable cards that
  keep Cuddle Care Box and Creator Club visible on mobile once the main nav
  collapses into the hamburger menu (theme.css hides .pp-nav and shows
  .pp-menu-toggle at max-width:990px — this section uses that exact same
  990px boundary for its own "mobile only" default, so it appears at
  precisely the breakpoint where those two destinations lose their normal
  nav visibility, not at an arbitrary phone-only width).

  Each card is a single <a> wrapping icon + heading + text + button label,
  so a tap anywhere in the card (icon, text, empty padding) follows the
  link — no separate nested button needed. Layout is a CSS Grid with
  repeat(auto-fit, minmax(...)) rather than a fixed 2-column rule with a
  manual stacking breakpoint: it keeps both cards side by side down to
  very narrow widths on its own (comfortably below 320px, this section's
  narrowest required test width) and only truly reflows to a single
  column if the available width drops below what a card actually needs —
  which is what "stack only if there isn't enough horizontal space, don't
  hard-code a breakpoint" means in practice. No carousel, no horizontal
  scroll: both cards always render in the document at once.

  Entrance animation reuses the theme's own existing reveal system rather
  than adding new JS: assets/theme.js auto-observes any .pp-section
  element and adds .is-visible via IntersectionObserver, and
  .pp-reveal/.pp-reveal.is-visible in theme.css do the fade+rise — already
  wired to respect prefers-reduced-motion and body.pp-motion-off. Adding
  the pp-section class (done conditionally below, per the "Entrance
  animation" toggle) is the entire implementation.

  Namespacing: every rule below is scoped under this section's own
  #shopify-section-{{ section.id }} id, and every class is pp-quicklinks*
  — nothing here can match .pp-card (product cards) or any other
  section's markup.
{% endcomment %}
{% liquid
  assign qc_mobile_only = false
  if section.settings.visibility == 'mobile_only'
    assign qc_mobile_only = true
  endif
%}
<style>
  #shopify-section-{{ section.id }} .pp-quicklinks {
    display: block;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_background }};
  }
  {% if qc_mobile_only %}
    #shopify-section-{{ section.id }} .pp-quicklinks {
      display: none;
    }
    @media (max-width: 990px) {
      #shopify-section-{{ section.id }} .pp-quicklinks {
        display: block;
      }
    }
  {% endif %}
  #shopify-section-{{ section.id }} .pp-quicklinks__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(126px, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    background: var(--qc-bg, #fff);
    border: 1.5px solid var(--qc-border, rgba(71, 16, 93, .12));
    border-radius: 18px;
    padding: 16px 14px;
    min-height: 150px;
    text-align: left;
    box-shadow: 0 4px 14px rgba(63, 14, 80, .05);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__card:hover,
  #shopify-section-{{ section.id }} .pp-quicklinks__card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 10px 22px rgba(63, 14, 80, .10);
    border-color: var(--qc-accent, #ff5a0a);
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__card:active {
    transform: translateY(0) scale(.98);
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--qc-accent, #ff5a0a) 14%, white);
    color: var(--qc-accent, #ff5a0a);
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__icon svg {
    width: 20px;
    height: 20px;
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__icon img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__heading {
    font-family: 'PP Aquatail', Georgia, serif;
    font-weight: 700;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.15;
    color: var(--ink, #351042);
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__text {
    font-family: 'PP Futura', Arial, sans-serif;
    font-weight: 400;
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.35;
    color: var(--muted, #776a7d);
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__btn {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-top: 4px;
    font-family: 'PP Futura', Arial, sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: .02em;
    color: var(--qc-accent, #ff5a0a);
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__btn svg {
    width: 13px;
    height: 13px;
    transition: transform .18s ease;
  }
  #shopify-section-{{ section.id }} .pp-quicklinks__card:hover .pp-quicklinks__btn svg {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-quicklinks__card,
    #shopify-section-{{ section.id }} .pp-quicklinks__btn svg {
      transition: none !important;
    }
  }
</style>
{% if section.settings.enable %}
<div
  class="pp-quicklinks{% if section.settings.enable_animation %} pp-section{% endif %}"
  data-pp-quicklinks
>
  <div class="page-width">
    <div class="pp-quicklinks__grid">
      {% for block in section.blocks %}
        {% liquid
          assign card_link = block.settings.link | default: '#'
        %}
        {% assign custom_icon_img = block.settings.custom_icon %}
{% assign custom_icon_img_mobile = block.settings.custom_icon_mobile %}
{% assign custom_icon_display = custom_icon_img | default: custom_icon_img_mobile %}
{% assign custom_icon_fit = block.settings.custom_icon_fit | default: 'contain' %}
{% assign custom_icon_position = block.settings.custom_icon_position | default: 'center center' %}
{% assign custom_icon_fit_m = block.settings.custom_icon_fit_mobile | default: 'contain' %}
{% assign custom_icon_position_m = block.settings.custom_icon_position_mobile | default: 'center center' %}
{% assign custom_icon_radius = block.settings.custom_icon_radius | default: 0 %}
{% assign custom_icon_radius_m = block.settings.custom_icon_radius_mobile | default: 0 %}
{% assign custom_icon_w = block.settings.custom_icon_max_width | default: 0 %}
{% assign custom_icon_h = block.settings.custom_icon_max_height | default: 0 %}
{% assign custom_icon_w_m = block.settings.custom_icon_max_width_mobile | default: 0 %}
{% assign custom_icon_h_m = block.settings.custom_icon_max_height_mobile | default: 0 %}
{% assign custom_icon_ha = block.settings.custom_icon_h_align | default: 'default' %}
{% assign custom_icon_va = block.settings.custom_icon_v_align | default: 'default' %}
{% assign custom_icon_ha_m = block.settings.custom_icon_h_align_mobile | default: 'default' %}
{% assign custom_icon_va_m = block.settings.custom_icon_v_align_mobile | default: 'default' %}
        <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-quicklinks__card[data-pp-block-id="{{ block.id }}"] .pp-quicklinks__icon img { object-fit: {{ custom_icon_fit }}; object-position: {{ custom_icon_position }}; }
  #shopify-section-{{ section.id }} .pp-quicklinks__card[data-pp-block-id="{{ block.id }}"] .pp-quicklinks__icon {
    {% if custom_icon_radius > 0 %}border-radius: {{ custom_icon_radius }}px; overflow: hidden;{% endif %}
    {% if custom_icon_w > 0 %}width: min({{ custom_icon_w }}px, 100%); max-width: 100%;{% endif %}
    {% if custom_icon_h > 0 %}height: min({{ custom_icon_h }}px, 100%); max-height: 100%;{% endif %}
    {% if custom_icon_ha == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if custom_icon_ha == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if custom_icon_ha == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if custom_icon_va == 'top' %}align-self: flex-start;{% endif %}
    {% if custom_icon_va == 'center' %}align-self: center;{% endif %}
    {% if custom_icon_va == 'bottom' %}align-self: flex-end;{% endif %}
  }
}
@media (max-width: 990px) {
  #shopify-section-{{ section.id }} .pp-quicklinks__card[data-pp-block-id="{{ block.id }}"] .pp-quicklinks__icon img { object-fit: {{ custom_icon_fit_m }}; object-position: {{ custom_icon_position_m }}; }
  #shopify-section-{{ section.id }} .pp-quicklinks__card[data-pp-block-id="{{ block.id }}"] .pp-quicklinks__icon {
    {% if custom_icon_radius_m > 0 %}border-radius: {{ custom_icon_radius_m }}px; overflow: hidden;{% endif %}
    {% if custom_icon_w_m > 0 %}width: min({{ custom_icon_w_m }}px, 100%); max-width: 100%;{% endif %}
    {% if custom_icon_h_m > 0 %}height: min({{ custom_icon_h_m }}px, 100%); max-height: 100%;{% endif %}
    {% if custom_icon_ha_m == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if custom_icon_ha_m == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if custom_icon_ha_m == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if custom_icon_va_m == 'top' %}align-self: flex-start;{% endif %}
    {% if custom_icon_va_m == 'center' %}align-self: center;{% endif %}
    {% if custom_icon_va_m == 'bottom' %}align-self: flex-end;{% endif %}
  }
}</style>
        <a
          class="pp-quicklinks__card"
          href="{{ card_link }}"
          style="--qc-accent:{{ block.settings.accent_color }};--qc-bg:{{ block.settings.background_color }};--qc-border:{{ block.settings.border_color }}"
          data-pp-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <span class="pp-quicklinks__icon" aria-hidden="true">
            {% if custom_icon_display != blank %}
  <picture>
    {% if custom_icon_img_mobile != blank and custom_icon_img_mobile != custom_icon_img %}
      <source media="(max-width: 990px)" srcset="{{ custom_icon_img_mobile | image_url: width: 400 }} 400w, {{ custom_icon_img_mobile | image_url: width: 600 }} 600w, {{ custom_icon_img_mobile | image_url: width: 800 }} 800w, {{ custom_icon_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ custom_icon_display | image_url: width: 64 | image_tag: loading: 'lazy', alt: '' }}
  </picture>
            {% else %}
              {% case block.settings.icon %}
                {% when 'paw' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="9" r="1.6"/><circle cx="12" cy="6.5" r="1.6"/><circle cx="17" cy="9" r="1.6"/><path d="M12 12.5c-3 0-5.5 1.9-5.5 4.6 0 1.6 1.3 2.4 2.9 2 1-.3 1.7-.7 2.6-.7s1.6.4 2.6.7c1.6.4 2.9-.4 2.9-2 0-2.7-2.5-4.6-5.5-4.6Z"/></svg>
                {% when 'camera' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13" r="3.4"/></svg>
                {% when 'creator' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5-3.6-3.5 5-.7L12 3Z"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8l9-4 9 4-9 4-9-4Z"/><path d="M3 8v8l9 4 9-4V8"/><path d="M12 12v8"/></svg>
              {% endcase %}
            {% endif %}
          </span>
          <span class="pp-quicklinks__body">
            <span class="pp-quicklinks__heading">{{ block.settings.heading }}</span>
            {% if block.settings.text != blank %}<span class="pp-quicklinks__text">{{ block.settings.text }}</span>{% endif %}
            {% if block.settings.button_label != blank %}
              <span class="pp-quicklinks__btn">
                {{ block.settings.button_label }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>
{% endif %}
{% schema %}
