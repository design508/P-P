{% render 'section-editor-styles', section: section %}
<section class="pp-why" style="--why-bg:{{ section.settings.background }};--why-blob-1:{{ section.settings.blob_color_1 }};--why-blob-2:{{ section.settings.blob_color_2 }};--why-heading:{{ section.settings.heading_color }};--why-card:{{ section.settings.card_background }};--sticker-bg:{{ section.settings.sticker_background }}">
  <div class="page-width pp-center">
    <div class="pp-kicker pp-kicker--light">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    <div class="pp-why__cards">
      {% for block in section.blocks %}
      <div class="pp-why__card" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }} style="--accent:{{ block.settings.accent }}">
        <h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="pp-sticker">{{ section.settings.sticker }}</div>
  </div>
</section>
