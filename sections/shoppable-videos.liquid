{% render 'section-editor-styles', section: section %}
{{ 'pp-pdp-videos-life.css' | asset_url | stylesheet_tag }}
{% assign has_video_content = false %}{% for block in section.blocks %}{% if block.settings.video != blank or block.settings.video_url != blank or block.settings.cover != blank or block.settings.cover_mobile != blank %}{% assign has_video_content = true %}{% endif %}{% endfor %}
{% if has_video_content or request.design_mode %}<section class="pp-shoppable-videos pp-section" style="background:{{ section.settings.background }}">
  <div class="page-width">
    <div class="pp-shoppable-videos__head">
      <div>
        <div class="pp-kicker">{{ section.settings.eyebrow }}</div>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
    </div>

    <div class="pp-video-reel">
      {% for block in section.blocks %}
        {% assign linked_product = block.settings.product %}
{% assign cover_img = block.settings.cover %}
{% assign cover_img_mobile = block.settings.cover_mobile %}
{% assign cover_display = cover_img | default: cover_img_mobile %}
{% assign cover_fit = block.settings.cover_fit | default: 'contain' %}
{% assign cover_position = block.settings.cover_position | default: 'center center' %}
{% assign cover_fit_m = block.settings.cover_fit_mobile | default: 'contain' %}
{% assign cover_position_m = block.settings.cover_position_mobile | default: 'center center' %}
{% assign cover_radius = block.settings.cover_radius | default: 0 %}
{% assign cover_radius_m = block.settings.cover_radius_mobile | default: 0 %}
{% assign cover_w = block.settings.cover_max_width | default: 0 %}
{% assign cover_h = block.settings.cover_max_height | default: 0 %}
{% assign cover_w_m = block.settings.cover_max_width_mobile | default: 0 %}
{% assign cover_h_m = block.settings.cover_max_height_mobile | default: 0 %}
{% assign cover_ha = block.settings.cover_h_align | default: 'default' %}
{% assign cover_va = block.settings.cover_v_align | default: 'default' %}
{% assign cover_ha_m = block.settings.cover_h_align_mobile | default: 'default' %}
{% assign cover_va_m = block.settings.cover_v_align_mobile | default: 'default' %}
        <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-video-card[data-pp-block-id="{{ block.id }}"] .pp-video-card__media img { object-fit: {{ cover_fit }}; object-position: {{ cover_position }}; }
  #shopify-section-{{ section.id }} .pp-video-card[data-pp-block-id="{{ block.id }}"] .pp-video-card__media {
    {% if cover_radius > 0 %}border-radius: {{ cover_radius }}px; overflow: hidden;{% endif %}
    {% if cover_w > 0 %}width: min({{ cover_w }}px, 100%); max-width: 100%;{% endif %}
    {% if cover_h > 0 %}height: min({{ cover_h }}px, 100%); max-height: 100%;{% endif %}
    {% if cover_ha == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if cover_ha == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if cover_ha == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if cover_va == 'top' %}align-self: flex-start;{% endif %}
    {% if cover_va == 'center' %}align-self: center;{% endif %}
    {% if cover_va == 'bottom' %}align-self: flex-end;{% endif %}
  }
}
@media (max-width: 990px) {
  #shopify-section-{{ section.id }} .pp-video-card[data-pp-block-id="{{ block.id }}"] .pp-video-card__media img { object-fit: {{ cover_fit_m }}; object-position: {{ cover_position_m }}; }
  #shopify-section-{{ section.id }} .pp-video-card[data-pp-block-id="{{ block.id }}"] .pp-video-card__media {
    {% if cover_radius_m > 0 %}border-radius: {{ cover_radius_m }}px; overflow: hidden;{% endif %}
    {% if cover_w_m > 0 %}width: min({{ cover_w_m }}px, 100%); max-width: 100%;{% endif %}
    {% if cover_h_m > 0 %}height: min({{ cover_h_m }}px, 100%); max-height: 100%;{% endif %}
    {% if cover_ha_m == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if cover_ha_m == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if cover_ha_m == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if cover_va_m == 'top' %}align-self: flex-start;{% endif %}
    {% if cover_va_m == 'center' %}align-self: center;{% endif %}
    {% if cover_va_m == 'bottom' %}align-self: flex-end;{% endif %}
  }
}</style>
        {% if block.settings.video != blank or block.settings.video_url != blank or cover_display != blank %}<article class="pp-video-card" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="pp-video-card__media">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: section.settings.video_autoplay, loop: section.settings.video_loop, muted: section.settings.video_muted, controls: section.settings.video_controls, playsinline: true, image_size: '700x' }}
            {% elsif block.settings.video_url != blank %}
              {% if block.settings.video_url.type == 'youtube' %}
                <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?playsinline=1&rel=0" title="{{ block.settings.title | escape }}" loading="lazy" allowfullscreen></iframe>
              {% elsif block.settings.video_url.type == 'vimeo' %}
                <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}" title="{{ block.settings.title | escape }}" loading="lazy" allowfullscreen></iframe>
              {% endif %}
            {% elsif cover_display != blank %}
              <picture>
    {% if cover_img_mobile != blank and cover_img_mobile != cover_img %}
      <source media="(max-width: 990px)" srcset="{{ cover_img_mobile | image_url: width: 400 }} 400w, {{ cover_img_mobile | image_url: width: 600 }} 600w, {{ cover_img_mobile | image_url: width: 800 }} 800w, {{ cover_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ cover_display | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
  </picture>
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
            {% if block.settings.badge != blank %}<span class="pp-video-card__badge">{{ block.settings.badge }}</span>{% endif %}
          </div>

          <div class="pp-video-card__body">
            <h3>{{ block.settings.title }}</h3>
            {% if linked_product != blank %}
              <a class="pp-video-product" href="{{ linked_product.url }}">
                <div class="pp-video-product__thumb">
                  {% if linked_product.featured_image %}
                    {{ linked_product.featured_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: linked_product.title }}
                  {% endif %}
                </div>
                <div class="pp-video-product__info">
                  <strong>{{ linked_product.title }}</strong>
                  <span>{{ linked_product.price | money }}</span>
                </div>
              </a>
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ linked_product.selected_or_first_available_variant.id }}">
                <button class="pp-btn pp-btn--orange pp-btn--wide" type="submit" {% unless linked_product.available %}disabled{% endunless %}>
                  {% render 'icon-bag' %} {% if linked_product.available %}{{ section.settings.shop_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}
                </button>
              </form>
            {% endif %}
          </div>
        </article>{% endif %}
      {% endfor %}
      {% if request.design_mode and has_video_content == false %}<div class="live-notes__editor-note">Add a verified Shopify video, YouTube/Vimeo URL or cover image to show this section on the storefront.</div>{% endif %}
    </div>
  </div>
</section>{% endif %}

{% schema %}
{"name":"Shoppable videos","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WATCH. SHOP. CUDDLE."},{"type":"text","id":"heading","label":"Heading","default":"See it in real life."},{"type":"textarea","id":"text","label":"Text","default":"Quick routines, real pets and the products that keep up."},{"type":"text","id":"shop_label","label":"Shop button label","default":"Shop this product"},{"type":"text","id":"sold_out_label","label":"Sold out label","default":"Sold out"},{"type":"color","id":"background","label":"Section background","default":"#ffffff"},{"type":"header","content":"Video behaviour"},{"type":"checkbox","id":"video_autoplay","label":"Autoplay Shopify videos","default":false},{"type":"checkbox","id":"video_loop","label":"Loop Shopify videos","default":true},{"type":"checkbox","id":"video_muted","label":"Mute Shopify videos","default":true},{"type":"checkbox","id":"video_controls","label":"Show video controls","default":true},{"type":"header","content":"Professional section controls"},{"type":"paragraph","content":"Optional overrides. Leave disabled to preserve the original V7 design."},{"type":"checkbox","id":"pp_custom_colors","label":"Override section colours","default":false},{"type":"color","id":"pp_background","label":"Background colour","default":"#ffffff"},{"type":"color","id":"pp_text_color","label":"Text colour","default":"#351042"},{"type":"color","id":"pp_accent_color","label":"Accent colour","default":"#ff5a0a"},{"type":"checkbox","id":"pp_custom_type","label":"Override section typography","default":false},{"type":"select","id":"pp_heading_font","label":"Heading font","default":"theme","options":[{"value":"theme","label":"Use theme default"},{"value":"aquatail","label":"Aquatail — included"},{"value":"futura","label":"Futura — included"}]},{"type":"select","id":"pp_heading_weight","label":"Heading weight","default":"700","options":[{"value":"400","label":"Regular"},{"value":"600","label":"Semibold"},{"value":"700","label":