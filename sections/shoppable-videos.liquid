<section class="pp-shoppable-videos"><div class="page-width"><header class="pp-shoppable-videos__head"><span class="pp-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></header><div class="pp-video-reel">{% for block in section.blocks %}{% assign featured_product = block.settings.product %}<article class="pp-video-card" {{ block.shopify_attributes }}><div class="pp-video-card__media">{% if block.settings.video_url != blank %}<video src="{{ block.settings.video_url }}"{% if section.settings.video_controls %} controls{% endif %}{% if section.settings.video_autoplay %} autoplay{% endif %}{% if section.settings.video_loop %} loop{% endif %}{% if section.settings.video_muted %} muted{% endif %} playsinline></video>{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}<span class="pp-video-card__badge">{{ block.settings.badge }}</span></div><div class="pp-video-card__body"><h3>{{ block.settings.title }}</h3>{% if featured_product != blank %}<a class="pp-video-product" href="{{ featured_product.url }}"><span class="pp-video-product__thumb">{% if featured_product.featured_image %}{{ featured_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: featured_product.title }}{% endif %}</span><span class="pp-video-product__info"><strong>{{ featured_product.title }}</strong><span>{{ featured_product.price | money }}</span></span></a><a class="pp-btn pp-btn--orange" href="{{ featured_product.url }}">{% if featured_product.available %}{{ section.settings.shop_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</a>{% endif %}</div></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Shoppable videos","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"text","label":"Text"},{"type":"text","id":"shop_label","label":"Shop label"},{"type":"text","id":"sold_out_label","label":"Sold-out label"},{"type":"checkbox","id":"video_autoplay","label":"Autoplay","default":false},{"type":"checkbox","id":"video_loop","label":"Loop","default":true},{"type":"checkbox","id":"video_muted","label":"Muted","default":true},{"type":"checkbox","id":"video_controls","label":"Controls","default":true}],"blocks":[{"type":"video","name":"Video","settings":[{"type":"url","id":"video_url","label":"Video URL"},{"type":"text","id":"badge","label":"Badge"},{"type":"text","id":"title","label":"Title"},{"type":"product","id":"product","label":"Product"}]}],"presets":[{"name":"Shoppable videos"}]}
{% endschema %}
