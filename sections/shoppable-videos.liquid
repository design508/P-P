e":"range","id":"cover_radius_mobile","min":0,"max":60,"step":2,"unit":"px","label":"Corner rounding (0 = theme default)","default":0},{"type":"header","content":"Image size — desktop"},{"type":"range","id":"cover_max_width","min":0,"max":1500,"step":50,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"cover_max_height","min":0,"max":1000,"step":50,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Image size — mobile"},{"type":"range","id":"cover_max_width_mobile","min":0,"max":900,"step":25,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"cover_max_height_mobile","min":0,"max":700,"step":25,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Box position — desktop"},{"type":"select","id":"cover_h_align","label":"Horizontal position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"cover_v_align","label":"Vertical position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"header","content":"Box position — mobile"},{"type":"select","id":"cover_h_align_mobile","label":"Horizontal position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"cover_v_align_mobile","label":"Vertical position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"text","id":"badge","label":"Small badge","default":"REAL ROUTINE"},{"type":"text","id":"title","label":"Video title","default":"Bath day, minus the drama."},{"type":"product","id":"product","label":"Product mini-card to shop (product image allowed here)"},{"type":"header","content":"Individual block design"},{"type":"checkbox","id":"pp_block_custom","label":"Customize this block","default":false},{"type":"color","id":"pp_block_background","label":"Card / block background","default":"#ffffff"},{"type":"color","id":"pp_block_text","label":"Text colour","default":"#351042"},{"type":"color","id":"pp_block_accent","label":"Accent / border colour","default":"#ff5a0a"},{"type":"select","id":"pp_block_heading_font","label":"Heading font","default":"theme","options":[{"value":"theme","label":"Use theme default"},{"value":"aquatail","label":"Aquatail — included"},{"value":"futura","label":"Futura — included"}]},{"type":"select","id":"pp_block_body_font","label":"Body font","default":"theme","options":[{"value":"theme","label":"Use theme default"},{"value":"aquatail","label":"Aquatail — inc