{% assign when_text = product.metafields.custom.when_to_use.value | default: product.metafields.custom.when_to_use %}{% assign steps = product.metafields.custom.how_to_use.value %}
<section class="pp-care-guide" style="--when-bg:{{ section.settings.when_background }};--how-bg:{{ section.settings.how_background }}"><div class="page-width"><header class="pp-care-guide__head"><span class="pp-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></header><div class="pp-care-guide__grid"><article class="pp-care-guide__when"><span class="pp-kicker">{{ section.settings.when_label }}</span><h3>{{ section.settings.when_heading }}</h3><div class="rte">{% if when_text != blank %}{{ when_text | metafield_tag }}{% else %}<p>{{ section.settings.when_fallback }}</p>{% endif %}</div></article><article class="pp-care-guide__how"><span class="pp-kicker">{{ section.settings.how_label }}</span>{% if steps != blank %}{% for step in steps %}<div class="pp-care-step"><b>{{ forloop.index | prepend: '0' }}</b><span>{{ step }}</span></div>{% endfor %}{% else %}<div class="pp-care-step"><b>01</b><span>{{ 'products.follow_directions' | t }}</span></div>{% endif %}</article></div></div></section>
{% schema %}
{"name":"Product care guide","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"color","id":"when_background","label":"When card background","default":"#fff1e9"},{"type":"color","id":"how_background","label":"How card background","default":"#47105d"},{"type":"text","id":"when_label","label":"When label"},{"type":"text","id":"when_heading","label":"When heading"},{"type":"textarea","id":"when_fallback","label":"When fallback"},{"type":"text","id":"how_label","label":"How label"}]}
{% endschema %}
