<section class="pp-pdp" data-product-root>
  <div class="page-width">
    {% if section.settings.show_breadcrumbs %}<nav class="pp-breadcrumb" aria-label="{{ 'products.breadcrumb' | t }}"><a href="{{ routes.root_url }}">{{ section.settings.home_label }}</a><span aria-hidden="true">/</span><span>{{ product.title }}</span></nav>{% endif %}
    <div class="pp-pdp__top">
      <div class="pp-pdp__gallery{% unless section.settings.show_thumbnails %} pp-pdp__gallery--no-thumbs{% endunless %}" data-pdp-gallery>
        {% if section.settings.show_thumbnails and product.media.size > 1 %}<div class="pp-pdp__thumbs">{% for media in product.media %}{% if media.media_type == 'image' %}<button class="pp-pdp__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-media-src="{{ media | image_url: width: 1400 }}" aria-label="{{ 'products.show_image' | t: index: forloop.index }}">{{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endif %}{% endfor %}</div>{% endif %}
        <div class="pp-pdp__stage{% if section.settings.enable_image_zoom %} pp-pdp__stage--zoom{% endif %}">
          {% if section.settings.show_stage_labels %}<span class="pp-pdp__stage-kicker">{{ section.settings.stage_kicker }}</span>{% endif %}
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 1600 | image_tag: class: 'pp-pdp__main-image', data-pdp-main: '', alt: product.featured_image.alt | default: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'pp-pdp__main-image' }}{% endif %}
          {% if section.settings.show_stage_labels %}<span class="pp-pdp__stage-note">{{ section.settings.stage_note }}</span>{% endif %}
        </div>
      </div>
      <div class="pp-pdp__info">
        <p class="pp-pdp__micro">{{ product.type | default: section.settings.fallback_type }}</p>
        <h1>{{ product.title }}</h1>
        {% assign tagline = product.metafields.custom.short_tagline.value | default: product.metafields.custom.short_tagline %}{% if tagline != blank %}<p class="pp-pdp__tagline">{{ tagline }}</p>{% endif %}
        {% if section.settings.show_description %}<div class="pp-pdp__desc rte">{{ product.description }}</div>{% endif %}
        <div class="pp-pdp__price-row"><span class="pp-pdp__price" data-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</span>{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{% endif %}</div>
        {% form 'product', product, class: 'pp-pdp__form' %}
          {% unless product.has_only_default_variant %}<label class="pp-pdp__variant-label" for="Variant-{{ section.id }}">{{ section.settings.variant_label }}</label><select id="Variant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money }}"{% if variant.featured_image %} data-image="{{ variant.featured_image | image_url: width: 1600 }}"{% endif %}{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — {{ section.settings.sold_out_label }}{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}
          <div class="pp-pdp__buyrow"><div class="pp-qty" data-qty><button type="button" data-qty-minus aria-label="{{ 'products.decrease_quantity' | t }}">−</button><input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.quantity' | t }}"><button type="button" data-qty-plus aria-label="{{ 'products.increase_quantity' | t }}">+</button></div><button class="pp-btn pp-btn--orange pp-pdp__add" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>{% if product.available %}{{ section.settings.add_label }}{% else %}{{ section.settings.sold_out_label }}{% endif %}</button>{% if section.settings.enable_buy_now %}{{ form | payment_button }}{% endif %}</div>
          <small class="pp-pdp__checkout-note">{{ section.settings.checkout_note }}</small>
        {% endform %}
        {% if section.settings.show_trust %}<div class="pp-pdp__trust">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><b>{{ block.settings.icon }}</b><span><strong>{{ block.settings.heading }}</strong><small>{{ block.settings.text }}</small></span></div>{% endfor %}</div>{% endif %}
      </div>
    </div>
  </div>
</section>
{% stylesheet %}.pp-breadcrumb{display:flex;gap:9px;align-items:center}.pp-pdp__main-image{width:100%;height:100%;object-fit:contain}.shopify-payment-button{min-width:0}.shopify-payment-button__button{border-radius:999px!important;min-height:54px!important}{% endstylesheet %}
{% schema %}
{"name":"Main product","settings":[{"type":"checkbox","id":"show_breadcrumbs","label":"Show breadcrumbs","default":true},{"type":"text","id":"home_label","label":"Home label","default":"Home"},{"type":"checkbox","id":"show_thumbnails","label":"Show thumbnails","default":true},{"type":"checkbox","id":"enable_image_zoom","label":"Enable image zoom","default":true},{"type":"color","id":"gallery_background","label":"Gallery background","default":"#fff9f5"},{"type":"checkbox","id":"show_stage_labels","label":"Show image labels","default":true},{"type":"text","id":"stage_kicker","label":"Image kicker","default":"ONE NEED. ONE CLEAR JOB."},{"type":"text","id":"stage_note","label":"Image note","default":"still cuddle-ready ↗"},{"type":"text","id":"fallback_type","label":"Fallback product type","default":"Pet care"},{"type":"checkbox","id":"show_description","label":"Show description","default":true},{"type":"text","id":"variant_label","label":"Variant label","default":"Choose option"},{"type":"text","id":"add_label","label":"Add label","default":"Add to care bag"},{"type":"text","id":"sold_out_label","label":"Sold-out label","default":"Sold out"},{"type":"checkbox","id":"enable_buy_now","label":"Enable buy now","default":true},{"type":"text","id":"buy_now_label","label":"Buy-now label","default":"Buy now"},{"type":"text","id":"checkout_note","label":"Checkout note"},{"type":"checkbox","id":"show_trust","label":"Show trust points","default":true}],"blocks":[{"type":"trust_point","name":"Trust point","settings":[{"type":"text","id":"icon","label":"Icon"},{"type":"text","id":"heading","label":"Heading"},{"type":"text","id":"text","label":"Text"}]}]}
{% endschema %}
