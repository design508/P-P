min":0,"max":1500,"step":50,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"image_max_height","min":0,"max":1000,"step":50,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Image size — mobile"},{"type":"range","id":"image_max_width_mobile","min":0,"max":900,"step":25,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"image_max_height_mobile","min":0,"max":700,"step":25,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Box position — desktop"},{"type":"select","id":"image_h_align","label":"Horizontal position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"image_v_align","label":"Vertical position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"header","content":"Box position — mobile"},{"type":"select","id":"image_h_align_mobile","label":"Horizontal position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"image_v_align_mobile","label":"Vertical position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"color","id":"card_color","label":"Card colour","default":"#fdf7fb"}]}],"presets":[{"name":"CC — Content Ideas","blocks":[{"type":"idea","settings":{"heading":"The post-bath fluff reveal","text":"Show the big fluffy transformation right after a wash.","icon":"🛁"}},{"type":"idea","settings":{"heading":"A real grooming routine","text":"Walk through your everyday grooming steps.","icon":"🩮"}},{"type":"idea","settings":{"heading":"First sniff or first reaction","text":"Capture the very first reaction to a new product.","icon":"👃"}},{"type":"idea","settings":{"heading":"Before and after playtime","text":"A muddy before, a happy clean after.","icon":"🎾"}},{"type":"idea","settings":{"heading":"Your pet's favourite Pups & Paws product","text":"Show off the one they can't get enough of.","icon":"💜"}},{"type":"idea","settings":{"heading":"Bedtime cuddles after bath day","text":"The cosy wind-down after a good scrub.","icon":"🌙"}},{"type":"idea","settings":{"heading":"A funny voice-over from your pet's perspective","text":"Give them a voice and let the personality shine.","icon":"🎙️"}},{"type":"idea","settings":{"heading":"Everyday walks, zoomies and little rituals","text":"The small, ordinary moments that are actually the best ones.","icon":"🐾"}}]}]}
