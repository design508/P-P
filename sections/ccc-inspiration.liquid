{% comment %} Creator Club — Content Inspiration. Classes: pp-ccc-idea* {% endcomment %}
{% render 'section-editor-styles', section: section %}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-idea-sec {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-idea-sec__head { text-align: center; margin-bottom: 36px; }
  #shopify-section-{{ section.id }} .pp-ccc-idea-sec h2 {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(28px, 3.4vw, 42px);
    color: var(--ink, #351042); margin: 0 0 10px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-idea-sec__sub { font-family: var(--body); font-size: 16px; color: var(--muted,#6b5b73); margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-idea__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 18px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-idea {
    border-radius: 20px;
    padding: 22px 18px;
    background: var(--pp-idea-bg, #fdf7fb);
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 100%;
    transform: rotate(var(--pp-tilt, 0deg));
    transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease;
  }
  /* Scrapbook tilt: a slight alternating rotation per card, repeating
     every 4 (matches the 4-column desktop grid). */
  #shopify-section-{{ section.id }} .pp-ccc-idea__grid > .pp-ccc-idea:nth-child(4n+1) { --pp-tilt: -2deg; }
  #shopify-section-{{ section.id }} .pp-ccc-idea__grid > .pp-ccc-idea:nth-child(4n+2) { --pp-tilt: 1.6deg; }
  #shopify-section-{{ section.id }} .pp-ccc-idea__grid > .pp-ccc-idea:nth-child(4n+3) { --pp-tilt: -1.4deg; }
  #shopify-section-{{ section.id }} .pp-ccc-idea__grid > .pp-ccc-idea:nth-child(4n+4) { --pp-tilt: 2deg; }
  #shopify-section-{{ section.id }} .pp-ccc-idea:hover {
    transform: translateY(-5px) rotate(var(--pp-tilt, 0deg));
    box-shadow: 0 16px 32px -18px rgba(53,16,66,.3);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-ccc-idea { transform: none; }
    #shopify-section-{{ section.id }} .pp-ccc-idea:hover { transform: translateY(-5px); }
  }
  #shopify-section-{{ section.id }} .pp-ccc-idea__media { border-radius: 14px; overflow: hidden; aspect-ratio: 4/3; background: rgba(0,0,0,.04); margin-bottom: 4px; }
  #shopify-section-{{ section.id }} .pp-ccc-idea__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  #shopify-section-{{ section.id }} .pp-ccc-idea:hover .pp-ccc-idea__media img { transform: scale(1.06); }
  #shopify-section-{{ section.id }} .pp-ccc-idea__icon { font-size: 22px; display: inline-block; transition: transform .35s cubic-bezier(.34,1.56,.64,1); }
  #shopify-section-{{ section.id }} .pp-ccc-idea:hover .pp-ccc-idea__icon { transform: rotate(-10deg) scale(1.2); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-ccc-idea,
    #shopify-section-{{ section.id }} .pp-ccc-idea__media img,
    #shopify-section-{{ section.id }} .pp-ccc-idea__icon { transition: none; }
  }
  #shopify-section-{{ section.id }} .pp-ccc-idea h3 { font-family: var(--body); font-weight: 800; font-size: 15px; color: var(--ink,#351042); margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-idea p { font-family: var(--body); font-size: 13.5px; line-height: 1.5; color: var(--muted,#6b5b73); margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-idea-sec__closing {
    text-align: center;
    font-family: var(--display);
    font-weight: 700;
    font-size: 19px;
    color: var(--ink,#351042);
    margin-top: 32px;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .pp-ccc-idea__grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @media screen and (max-width: 540px) {
    #shopify-section-{{ section.id }} .pp-ccc-idea__grid { grid-template-columns: 1fr; }
  }
</style>
<section class="pp-ccc-idea-sec pp-reveal" id="ccc-ideas">
  <div class="page-width">
    <div class="pp-ccc-idea-sec__head">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p class="pp-ccc-idea-sec__sub">{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="pp-ccc-idea__grid">
      {% for block in section.blocks %}
        {% if block.type == 'idea' and block.settings.enable %}
          {% assign image_img = block.settings.image %}
{% assign image_img_mobile = block.settings.image_mobile %}
{% assign image_display = image_img | default: image_img_mobile %}
{% assign image_fit = block.settings.image_fit | default: 'contain' %}
{% assign image_position = block.settings.image_position | default: 'center center' %}
{% assign image_fit_m = block.settings.image_fit_mobile | default: 'contain' %}
{% assign image_position_m = block.settings.image_position_mobile | default: 'center center' %}
{% assign image_radius = block.settings.image_radius | default: 0 %}
{% assign image_radius_m = block.settings.image_radius_mobile | default: 0 %}
{% assign image_w = block.settings.image_max_width | default: 0 %}
{% assign image_h = block.settings.image_max_height | default: 0 %}
{% assign image_w_m = block.settings.image_max_width_mobile | default: 0 %}
{% assign image_h_m = block.settings.image_max_height_mobile | default: 0 %}
{% assign image_ha = block.settings.image_h_align | default: 'default' %}
{% assign image_va = block.settings.image_v_align | default: 'default' %}
{% assign image_ha_m = block.settings.image_h_align_mobile | default: 'default' %}
{% assign image_va_m = block.settings.image_v_align_mobile | default: 'default' %}
          <div class="pp-ccc-idea" style="--pp-idea-bg:{{ block.settings.card_color }}" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-ccc-idea[data-pp-block-id="{{ block.id }}"] .pp-ccc-idea__media img { object-fit: {{ image_fit }}; object-position: {{ image_position }}; }
  #shopify-section-{{ section.id }} .pp-ccc-idea[data-pp-block-id="{{ block.id }}"] .pp-ccc-idea__media {
    {% if image_radius > 0 %}border-radius: {{ image_radius }}px; overflow: hidden;{% endif %}
    {% if image_w > 0 %}width: min({{ image_w }}px, 100%); max-width: 100%;{% endif %}
    {% if image_h > 0 %}height: min({{ image_h }}px, 100%); max-height: 100%;{% endif %}
    {% if image_ha == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if image_ha == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if image_ha == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if image_va == 'top' %}align-self: flex-start;{% endif %}
    {% if image_va == 'center' %}align-self: center;{% endif %}
    {% if image_va == 'bottom' %}align-self: flex-end;{% endif %}
  }
}
@media (max-width: 990px) {
  #shopify-section-{{ section.id }} .pp-ccc-idea[data-pp-block-id="{{ block.id }}"] .pp-ccc-idea__media img { object-fit: {{ image_fit_m }}; object-position: {{ image_position_m }}; }
  #shopify-section-{{ section.id }} .pp-ccc-idea[data-pp-block-id="{{ block.id }}"] .pp-ccc-idea__media {
    {% if image_radius_m > 0 %}border-radius: {{ image_radius_m }}px; overflow: hidden;{% endif %}
    {% if image_w_m > 0 %}width: min({{ image_w_m }}px, 100%); max-width: 100%;{% endif %}
    {% if image_h_m > 0 %}height: min({{ image_h_m }}px, 100%); max-height: 100%;{% endif %}
    {% if image_ha_m == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if image_ha_m == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if image_ha_m == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if image_va_m == 'top' %}align-self: flex-start;{% endif %}
    {% if image_va_m == 'center' %}align-self: center;{% endif %}
    {% if image_va_m == 'bottom' %}align-self: flex-end;{% endif %}
  }
}</style>
            {% if image_display != blank %}
              <div class="pp-ccc-idea__media">
  <picture>
    {% if image_img_mobile != blank and image_img_mobile != image_img %}
      <source media="(max-width: 990px)" srcset="{{ image_img_mobile | image_url: width: 400 }} 400w, {{ image_img_mobile | image_url: width: 600 }} 600w, {{ image_img_mobile | image_url: width: 800 }} 800w, {{ image_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ image_display | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,350,500', alt: block.settings.heading }}
  </picture>
              </div>
            {% elsif block.settings.icon != blank %}
              <span class="pp-ccc-idea__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {% endif %}
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.closing != blank %}<p class="pp-ccc-idea-sec__closing">{{ section.settings.closing }}</p>{% endif %}
  </div>
</section>
{% schema %}
{"name":"CC — Content Ideas","settings":[{"type":"text","id":"heading","label":"Heading","default":"Your pet already gives you content."},{"type":"text","id":"text","label":"Supporting copy","default":"Keep it honest, playful and completely you."},{"type":"text","id":"closing","label":"Closing line","default":"Perfect is forgettable. Real pet-parent moments are not."},{"type":"header","content":"Colours"},{"type":"color","id":"background","label":"Section background","default":"#ffffff"},{"type":"header","content":"Section spacing"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Top padding — desktop","default":64},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Bottom padding — desktop","default":64}],"blocks":[{"type":"idea","name":"Reel idea","settings":[{"type":"checkbox","id":"enable","label":"Enable","default":true},{"type":"text","id":"heading","label":"Heading","default":"The post-bath fluff reveal"},{"type":"textarea","id":"text","label":"Short description","default":"Show the big fluffy transformation right after a wash."},{"type":"text","id":"icon","label":"Emoji icon (used if no image set)","default":"🛁"},{"type":"header","content":"Image (optional, overrides icon) — desktop"},{"type":"image_picker","id":"image","label":"Image (optional, overrides icon) (desktop)","info":"A transparent PNG works best."},{"type":"header","content":"Image (optional, overrides icon) — mobile"},{"type":"image_picker","id":"image_mobile","label":"Image (optional, overrides icon) — mobile (optional)","info":"Shown at 990px and narrower instead of the desktop image above. Leave empty to use the same image on mobile."},{"type":"header","content":"Image fit — desktop"},{"type":"select","id":"image_fit","label":"How the photo fills its box","default":"contain","options":[{"value":"contain","label":"Show the whole photo (may leave empty space)"},{"value":"cover","label":"Fill the box completely (may crop)"}]}