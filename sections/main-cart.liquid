{% render 'section-editor-styles', section: section %}
<section class="pp-section"><div class="page-width">
  <h1>{{ section.settings.heading }}</h1>
  {% if cart.item_count == 0 %}
    <p>{{ section.settings.empty_text }}</p>
    <a class="pp-btn pp-btn--purple" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_button_label }}</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="pp-cart">
        {% for item in cart.items %}
          <div class="pp-cart__item">
            <a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}</a>
            <div>
              {% if section.settings.show_vendor and item.product.vendor != blank %}<div class="pp-kicker">{{ item.product.vendor }}</div>{% endif %}
              <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
              {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}
              {% for property in item.properties %}{% unless property.last == blank %}<small>{{ property.first }}: {{ property.last }}</small>{% endunless %}{% endfor %}
              <p>{{ item.final_line_price | money }}</p>
              <label class="pp-cart__quantity">{{ section.settings.quantity_label }} <input type="number" min="0" name="updates[]" value="{{ item.quantity }}"></label>
              <a class="pp-text-link pp-cart__remove" href="{{ item.url_to_remove }}">{{ section.settings.remove_label }}</a>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.show_cart_note %}
        <label class="pp-cart__note">{{ section.settings.cart_note_label }}<textarea name="note">{{ cart.note }}</textarea></label>
      {% endif %}
      <div class="pp-cart__summary">
        <span>{{ section.settings.subtotal_label }}</span>
        <h2>{{ cart.total_price | money }}</h2>
        <button class="pp-btn pp-btn--outline" name="update">{{ section.settings.update_label }}</button>
        <button class="pp-btn pp-btn--orange" name="checkout">{{ section.settings.checkout_label }}</button>
      </div>
      {% if section.settings.continue_label != blank %}<a class="pp-text-link" href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}">{{ section.settings.continue_label }}</a>{% endif %}
    </form>
  {% endif %}
</div></section>
