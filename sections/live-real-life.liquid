{% render 'section-editor-styles', section: section %}
{{ 'pp-real-life-life.css' | asset_url | stylesheet_tag }}
<section class="live-real-life pp-section" style="--life-bg:{{ section.settings.background }};--life-text:{{ section.settings.text_color }}">
  <div class="page-width live-real-life__grid">
    <div class="pp-reveal">
      <div class="live-eyebrow live-eyebrow--light">{{ section.settings.eyebrow }}</div>
      <h2>{{ section.settings.heading | newline_to_br }}</h2>
    </div>
    <div class="live-real-life__copy pp-reveal">
      <p>{{ section.settings.text }}</p>
      <div class="live-real-life__chips">{% for block in section.blocks %}<span data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}><i style="background:{{ block.settings.color }};--chip-glow:{{ block.settings.color }}"></i>{{ block.settings.text }}</span>{% endfor %}</div>
      {% if section.settings.button_label != blank %}<a class="pp-btn pp-btn--white" href="{{ section.settings.button_link | default: '/collections/grooming' }}">{{ section.settings.button_label }} {% render 'icon-arrow' %}</a>{% endif %}
    </div>
  </div>
  <div class="live-real-life__marquee" aria-hidden="true"><span>{{ section.settings.marquee }}</span><span>{{ section.settings.marquee }}</span></div>
</section>
