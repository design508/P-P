{% if section.settings.enable %}
  {% assign eligible = true %}{% if section.settings.eligible_collection != blank %}{% assign eligible = false %}{% for collection in product.collections %}{% if collection.handle == section.settings.eligible_collection.handle %}{% assign eligible = true %}{% endif %}{% endfor %}{% endif %}
  {% if eligible %}<section class="pp-ccb" style="--ccb-bg:{{ section.settings.section_background }};--ccb-card:{{ section.settings.card_background }};--ccb-accent:{{ section.settings.accent_color }};--ccb-radius:{{ section.settings.border_radius }}px"><div class="page-width"><div class="pp-ccb__card"><span class="pp-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p><ol><li>{{ section.settings.step_one }}</li><li>{{ section.settings.step_two }}</li><li>{{ section.settings.step_three }}</li></ol><a class="pp-btn pp-btn--orange" data-ccb-cta data-builder-url="{{ pages[section.settings.builder_page].url | default: '/pages/build-your-own-box' }}" data-product-handle="{{ product.handle }}" data-default-variant="{{ product.selected_or_first_available_variant.id }}" href="{{ pages[section.settings.builder_page].url | default: '/pages/build-your-own-box' }}?variant={{ product.selected_or_first_available_variant.id }}&product={{ product.handle }}">{{ section.settings.button_text }}</a></div></div></section>{% endif %}
{% endif %}
{% stylesheet %}.pp-ccb{background:var(--ccb-bg);padding:24px 0}.pp-ccb__card{background:var(--ccb-card);border:1px solid var(--line);border-radius:var(--ccb-radius);padding:28px}.pp-ccb__card h2{margin:8px 0}.pp-ccb__card ol{display:flex;gap:24px;flex-wrap:wrap;padding-left:20px}{% endstylesheet %}
{% schema %}
{"name":"PDP Cuddle Care Box","settings":[{"type":"checkbox","id":"enable","label":"Enable","default":true},{"type":"collection","id":"eligible_collection","label":"Eligible collection"},{"type":"page","id":"builder_page","label":"Builder page"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"description","label":"Description"},{"type":"text","id":"step_one","label":"Step one"},{"type":"text","id":"step_two","label":"Step two"},{"type":"text","id":"step_three","label":"Step three"},{"type":"text","id":"button_text","label":"Button text"},{"type":"color","id":"section_background","label":"Section background","default":"#ffffff"},{"type":"color","id":"card_background","label":"Card background","default":"#ffffff"},{"type":"color","id":"accent_color","label":"Accent","default":"#ff5a0a"},{"type":"range","id":"border_radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":24}]}
{% endschema %}
