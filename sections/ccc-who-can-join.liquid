{% comment %} Creator Club — Who Can Join. Classes: pp-ccc-join* {% endcomment %}
{% render 'section-editor-styles', section: section %}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-join {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-join__head { text-align: center; max-width: 62ch; margin: 0 auto 36px; }
  #shopify-section-{{ section.id }} .pp-ccc-join h2 { font-family: var(--display); font-weight: 800; font-size: clamp(26px,3.2vw,38px); color: var(--ink,#351042); margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .pp-ccc-join__sub { font-family: var(--body); font-size: 15.5px; color: var(--muted,#6b5b73); margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px,1fr));
    gap: 16px;
    max-width: 920px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .pp-ccc-join__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--line,#eee0ee);
    border-radius: 18px;
    padding: 18px;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity .5s ease, transform .5s ease;
  }
  #shopify-section-{{ section.id }} .pp-ccc-join.is-visible .pp-ccc-join__item {
    opacity: 1;
    transform: translateY(0);
  }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid > .pp-ccc-join__item:nth-child(1) { transition-delay: .05s; }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid > .pp-ccc-join__item:nth-child(2) { transition-delay: .18s; }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid > .pp-ccc-join__item:nth-child(3) { transition-delay: .31s; }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid > .pp-ccc-join__item:nth-child(4) { transition-delay: .44s; }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid > .pp-ccc-join__item:nth-child(5) { transition-delay: .57s; }
  #shopify-section-{{ section.id }} .pp-ccc-join__check {
    flex: 0 0 auto;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: {{ section.settings.check_color }};
    color: #fff;
    display: grid; place-items: center;
    font-size: 14px;
    font-weight: 800;
  }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid > .pp-ccc-join__item:nth-child(3n+2) .pp-ccc-join__check { background: var(--orange, #ff5a0a); }
  #shopify-section-{{ section.id }} .pp-ccc-join__grid > .pp-ccc-join__item:nth-child(3n+3) .pp-ccc-join__check { background: var(--pink, #ff2b78); }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-join.is-visible .pp-ccc-join__item .pp-ccc-join__check {
      animation: pp-ccc-check-pop .45s cubic-bezier(.34,1.56,.64,1) .1s both;
    }
  }
  @keyframes pp-ccc-check-pop {
    0% { transform: scale(.3); }
    70% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-ccc-join__item { opacity: 1; transform: none; transition: none; }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-join__item { opacity: 1 !important; transform: none !important; }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-join__check { animation: none !important; }
  #shopify-section-{{ section.id }} .pp-ccc-join__item p { font-family: var(--body); font-size: 14.5px; line-height: 1.5; color: var(--ink,#351042); margin: 0; font-weight: 600; }
</style>
<section class="pp-ccc-join pp-reveal">
  <div class="page-width">
    <div class="pp-ccc-join__head">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p class="pp-ccc-join__sub">{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="pp-ccc-join__grid">
      {% for block in section.blocks %}
        {% if block.type == 'item' and block.settings.enable %}
          <div class="pp-ccc-join__item" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            <span class="pp-ccc-join__check" aria-hidden="true">✓</span>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CC — Who Can Join",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "If you're a pet parent, you're already our kind of creator." },
    { "type": "textarea", "id": "text", "label": "Supporting copy", "default": "Big creator, small creator or first-time creator—the size of your following matters less than the honesty of your story." },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "check_color", "label": "Checkmark colour", "default": "#3dc842" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding — desktop", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding — desktop", "default": 64 }
  ],
  "blocks": [
    { "type": "item", "name": "Checklist item", "settings": [
      { "type": "checkbox", "id": "enable", "label": "Enable", "default": true },
      { "type": "text", "id": "text", "label": "Text", "default": "You have purchased a Pups & Paws product" }
    ]}
  ],
  "presets": [
    { "name": "CC — Who Can Join", "blocks": [
      { "type": "item", "settings": { "text": "You have purchased a Pups & Paws product" } },
      { "type": "item", "settings": { "text": "You have an active public Instagram account" } },
      { "type": "item", "settings": { "text": "You can create an original reel featuring your pet" } },
      { "type": "item", "settings": { "text": "You are comfortable tagging Pups & Paws" } },
      { "type": "item", "settings": { "text": "You agree to the Creator Club terms" } }
    ]}
  ]
}
{% endschema %}
