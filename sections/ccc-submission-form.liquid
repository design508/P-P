{% comment %}
  Creator Club — Submission Form (PLACEHOLDER)
  ------------------------------------------------------------------------
  Per the merchant's explicit decision, the real submission form is being
  built in a follow-up pass once the data-storage approach is chosen
  (native Shopify contact form vs. a form app). This section intentionally
  ships as a clearly-labelled, on-brand placeholder rather than a
  half-wired form, so nothing broken or misleading ships in the meantime.

  It still provides the section ID other CTAs scroll to (#creator-club-form)
  and the editable terms note (spec section 12), since neither depends on
  the storage decision.
{% endcomment %}
{% render 'section-editor-styles', section: section %}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-form-sec {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-form-sec__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .pp-ccc-form-sec h2 {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(26px,3.2vw,38px);
    color: var(--ink,#351042);
    margin: 0 0 12px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-form-sec__intro {
    font-family: var(--body); font-size: 15.5px; color: var(--muted,#6b5b73);
    margin: 0 0 30px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-form-placeholder {
    border: 2px dashed var(--orange, #ff5a0a);
    border-radius: 22px;
    padding: 40px 28px;
    background: #fdf7fb;
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-form-placeholder {
      animation: pp-ccc-form-border-pulse 2.6s ease-in-out infinite;
    }
  }
  @keyframes pp-ccc-form-border-pulse {
    0%, 100% { border-color: var(--orange, #ff5a0a); }
    50% { border-color: var(--pink, #ff2b78); }
  }
  #shopify-section-{{ section.id }} .pp-ccc-form-placeholder__icon {
    font-size: 32px;
    margin-bottom: 12px;
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-form-placeholder__icon {
      animation: pp-ccc-paw-wiggle 2.6s ease-in-out infinite;
    }
  }
  @keyframes pp-ccc-paw-wiggle {
    0%, 100% { transform: rotate(0deg); }
    20% { transform: rotate(-12deg); }
    40% { transform: rotate(9deg); }
    60% { transform: rotate(-6deg); }
    80% { transform: rotate(4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-ccc-form-placeholder,
    #shopify-section-{{ section.id }} .pp-ccc-form-placeholder__icon { animation: none !important; }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-form-placeholder,
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-form-placeholder__icon { animation: none !important; }
  #shopify-section-{{ section.id }} .pp-ccc-form-placeholder h3 {
    font-family: var(--body); font-weight: 800; font-size: 16px; color: var(--ink,#351042); margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-form-placeholder p { font-family: var(--body); font-size: 14px; line-height: 1.6; color: var(--muted,#6b5b73); margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-form-sec__terms {
    margin-top: 26px;
    font-family: var(--body);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--muted,#6b5b73);
  }
  #shopify-section-{{ section.id }} .pp-ccc-form-sec__terms a { color: {{ section.settings.accent_color }}; font-weight: 700; }
  #shopify-section-{{ section.id }} .pp-ccc-form-sec__warning {
    margin-top: 14px;
    font-family: var(--body);
    font-size: 12.5px;
    color: #b23b1f;
    background: #fff1ea;
    border-radius: 10px;
    padding: 10px 14px;
    display: inline-block;
  }
</style>
<section class="pp-ccc-form-sec pp-reveal" id="creator-club-form">
  <div class="page-width">
    <div class="pp-ccc-form-sec__inner">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}<p class="pp-ccc-form-sec__intro">{{ section.settings.intro }}</p>{% endif %}

      <div class="pp-ccc-form-placeholder">
        <div class="pp-ccc-form-placeholder__icon" aria-hidden="true">🐾</div>
        <h3>{{ section.settings.placeholder_heading }}</h3>
        <p>{{ section.settings.placeholder_text }}</p>
      </div>

      {% if section.settings.terms_note != blank %}
        <p class="pp-ccc-form-sec__terms">
          {{ section.settings.terms_note }}
          {% if section.settings.terms_page != blank %}
            <a href="{{ section.settings.terms_page.url }}">{{ section.settings.terms_link_label | default: 'Read the Creator Club terms' }}</a>
          {% endif %}
        </p>
      {% endif %}
      {% if section.settings.terms_page == blank and request.design_mode %}
        <span class="pp-ccc-form-sec__warning">⚠️ No terms page selected — choose one in this section's settings before publishing, or this note will show without a working link.</span>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "CC — Signup Form",
  "settings": [
    { "type": "paragraph", "content": "This section currently shows a placeholder instead of a live form, per your request to finalize the data-storage approach (native Shopify contact form vs. a form app) before wiring it up. The terms note below is already live and editable." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to join the pack?" },
    { "type": "textarea", "id": "intro", "label": "Intro copy", "default": "Tell us a little about you, your pet and the reel you created." },
    { "type": "header", "content": "Placeholder message" },
    { "type": "text", "id": "placeholder_heading", "label": "Placeholder heading", "default": "Submissions open soon" },
    { "type": "textarea", "id": "placeholder_text", "label": "Placeholder text", "default": "We're putting the finishing touches on the creator submission form. Check back shortly to send in your reel." },
    { "type": "header", "content": "Terms note (spec section 12)" },
    { "type": "textarea", "id": "terms_note", "label": "Terms note", "default": "Participation is subject to verification and the official Pups & Paws Creator Club terms. Rewards, eligibility and timelines may vary." },
    { "type": "page", "id": "terms_page", "label": "Creator Club terms page", "info": "If left blank, a warning shows in the Theme Editor and the link is omitted on the storefront." },
    { "type": "text", "id": "terms_link_label", "label": "Terms link label", "default": "Read the Creator Club terms" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Link colour", "default": "#47105d" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding — desktop", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding — desktop", "default": 64 }
  ],
  "presets": [{ "name": "CC — Signup Form" }]
}
{% endschema %}
