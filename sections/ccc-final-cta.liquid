{% comment %} Creator Club — Final CTA. Classes: pp-ccc-cta* {% endcomment %}
{% render 'section-editor-styles', section: section %}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-cta {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.background }};
    background-image: linear-gradient(120deg, {{ section.settings.background }}, color-mix(in srgb, var(--orange, #ff5a0a) 18%, {{ section.settings.background }}), {{ section.settings.background }});
    background-size: 220% 220%;
    border-radius: 32px;
    padding: 56px 32px;
    text-align: center;
    isolation: isolate;
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-cta {
      animation: pp-ccc-cta-gradient-pulse 7s ease-in-out infinite;
    }
  }
  @keyframes pp-ccc-cta-gradient-pulse {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-cta { animation: none !important; }
  #shopify-section-{{ section.id }} .pp-ccc-cta__wrap { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} .pp-ccc-cta h2 {
    font-family: var(--display); font-weight: 800;
    font-size: clamp(28px,3.6vw,44px);
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
    max-width: 26ch;
    margin-left: auto; margin-right: auto;
  }
  #shopify-section-{{ section.id }} .pp-ccc-cta p {
    font-family: var(--body); font-size: 16px; line-height: 1.6;
    color: {{ section.settings.text_color }};
    max-width: 52ch; margin: 0 auto 28px;
    opacity: .9;
  }
  #shopify-section-{{ section.id }} .pp-ccc-cta__actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px; }
  #shopify-section-{{ section.id }} .pp-ccc-cta__paw {
    position: absolute;
    font-size: 60px;
    opacity: .12;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .pp-ccc-cta__paw--1 { top: -10px; left: 4%; transform: rotate(-12deg); }
  #shopify-section-{{ section.id }} .pp-ccc-cta__paw--2 { bottom: -14px; right: 5%; transform: rotate(16deg); font-size: 74px; }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-cta__paw--1 { animation: pp-ccc-bob-a 6.5s ease-in-out infinite; }
    #shopify-section-{{ section.id }} .pp-ccc-cta__paw--2 { animation: pp-ccc-bob 6s ease-in-out infinite .6s; }
    @keyframes pp-ccc-bob { 0%,100%{transform: rotate(16deg) translateY(0);} 50%{transform: rotate(16deg) translateY(-10px);} }
    @keyframes pp-ccc-bob-a { 0%,100%{transform: rotate(-12deg) translateY(0);} 50%{transform: rotate(-12deg) translateY(-8px);} }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-cta__paw--1,
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-cta__paw--2 { animation: none !important; }
</style>
<div class="pp-ccc-cta__wrap page-width">
  <section class="pp-ccc-cta pp-reveal">
    <span class="pp-ccc-cta__paw pp-ccc-cta__paw--1" aria-hidden="true">🐾</span>
    <span class="pp-ccc-cta__paw pp-ccc-cta__paw--2" aria-hidden="true">🐾</span>
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    <div class="pp-ccc-cta__actions">
      {% if section.settings.primary_label != blank %}
        <a href="#{{ section.settings.primary_target | default: 'creator-club-form' }}" class="pp-btn pp-btn--orange" data-ccc-smooth-scroll>{{ section.settings.primary_label }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a href="{{ section.settings.shop_collection.url | default: '/collections/all' }}" class="pp-btn pp-btn--outline">{{ section.settings.secondary_label }}</a>
      {% endif %}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Creator Club — Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Their next zoomie could make them a star." },
    { "type": "textarea", "id": "text", "label": "Copy", "default": "Capture the cuddles, the chaos and everything in between. Share your Pups & Paws moment and join a growing pack of real pet parents." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Join the Creator Club" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Shop Their Favourites" },
    { "type": "collection", "id": "shop_collection", "label": "Secondary button destination collection" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f3e9f8" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#351042" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#351042" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding — desktop", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding — desktop", "default": 72 }
  ],
  "presets": [{ "name": "Creator Club — Final CTA" }]
}
{% endschema %}
