{% render 'section-editor-styles', section: section %}
{{ 'pp-ccc-ticker-life.css' | asset_url | stylesheet_tag }}
<div class="pp-ticker{% if section.settings.pause_on_hover %} pp-ticker--pausable{% endif %}" role="region" aria-label="{{ section.settings.accessibility_label }}" style="--ticker-bg:{{ section.settings.background }};--ticker-text:{{ section.settings.text_color }};--ticker-accent:{{ section.settings.accent_color }};--ticker-speed:{{ section.settings.speed }}s">
  {% if section.settings.link != blank %}<a href="{{ section.settings.link }}" class="pp-ticker__track">{% else %}<div class="pp-ticker__track">{% endif %}
    {% if section.settings.text_1 != blank %}<span>{{ section.settings.text_1 }}</span><i>✦</i>{% endif %}
    {% if section.settings.text_2 != blank %}<span>{{ section.settings.text_2 }}</span><i>✦</i>{% endif %}
    {% if section.settings.text_3 != blank %}<span>{{ section.settings.text_3 }}</span><i>✦</i>{% endif %}
    <span aria-hidden="true">{{ section.settings.text_1 }}</span><i aria-hidden="true">✦</i>
    <span aria-hidden="true">{{ section.settings.text_2 }}</span>
  {% if section.settings.link != blank %}</a>{% else %}</div>{% endif %}
</div>
{% schema %}
{
  "name": "Announcement ticker",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Announcement"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Message 1",
      "default": "CARE AS LOYAL AS THEIR LOVE."
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Message 2",
      "default": "Made for Indian weather, muddy walks and real homes."
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Message 3",
      "default": "STILL ALLOWED ON THE BED."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#47105d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Sparkle colour",
      "default": "#ff9d45"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "s",
      "label": "Ticker speed",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Professional section controls"
    },
    {
      "type": "paragraph",
      "content": "Optional overrides. Leave disabled to preserve the original V7 design."
    },
    {
      "type": "checkbox",
      "id": "pp_custom_colors",
      "label": "Override section colours",
      "default": false
    },
    {
      "type": "color",
      "id": "pp_background",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pp_text_color",
      "label": "Text colour",
      "default": "#351042"
    },
    {
      "type": "color",
      "id": "pp_accent_color",
      "label": "Accent colour",
      "default": "#ff5a0a"
    },
    {
      "type": "checkbox",
      "id": "pp_custom_type",
      "label": "Override section typography",
      "default": false
    },
    {
      "type": "select",
      "id": "pp_heading_font",
      "label": "Heading font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Use theme default"
        },
        {
          "value": "aquatail",
          "label": "Aquatail — included"
        },
        {
          "value": "futura",
          "label": "Futura — included"
        }
      ]
    },
    {
      "type": "select",
      "id": "pp_heading_weight",
      "label": "Heading weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "pp_heading_size",
      "min": 24,
      "max": 104,
      "step": 2,
      "unit": "px",
      "label": "Heading size — desktop",
      "default": 64
    },
    {
      "type": "range",
      "id": "pp_heading_size_mobile",
      "min": 22,
      "max": 70,
      "step": 2,
      "unit": "px",
      "label": "Heading size — mobile",
      "default": 44
    },
    {
      "type": "range",
      "id": "pp_heading_tracking",
      "min": -8,
      "max": 10,
      "step": 1,
      "unit": "%",
      "label": "Heading letter spacing",
      "default": -3
    },
    {
      "type": "select",
      "id": "pp_body_font",
      "label": "Body font",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Use theme default"
        },
        {
          "value": "aquatail",
          "label": "Aquatail — included"
        },
        {
          "value": "futura",
          "label": "Futura — included"
        }
      ]
    },
    {
      "type": "select",
      "id": "pp_body_weight",
      "label": "Body weight",
      "default": "400",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "pp_body_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body size — desktop",
      "default": 16
    },
    {
      "type": "range",
      "id": "pp_body_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Body size — mobile",
      "default": 15
    },
    {
      "type": "range",
      "id": "pp_line_height",
      "min": 10,
      "max": 20,
      "step": 1,
      "label": "Body line height",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "pp_custom_spacing",
      "label": "Override section spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "pp_padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding — desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "pp_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding — desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "pp_padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding — mobile",
      "default": 56
    },
    {
      "type": "range",
      "id": "pp_padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding — mobile",
      "default": 56
    },
    {
      "type": "range",
      "id": "pp_content_width",
      "min": 0,
      "max": 1800,
      "step": 100,
      "unit": "px",
      "label": "Content width (0 = theme default)",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "pp_disable_motion",
      "label": "Disable motion in this section",
      "default": false
    },
    {
      "type": "header",
      "content": "Button controls"
    },
    {
      "type": "checkbox",
      "id": "pp_custom_buttons",
      "label": "Customize buttons in this section",
      "default": false
    },
    {
      "type": "color",
      "id": "pp_button_background",
      "label": "Button background",
      "default": "#47105d"
    },
    {
      "type": "color",
      "id": "pp_button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pp_button_height",
      "min": 32,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Button height",
      "default": 48
    },
    {
      "type": "range",
      "id": "pp_button_radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Button corner radius",
      "default": 40
    },
    {
      "type": "range",
      "id": "pp_min_height",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Section minimum height (0 = automatic)",
      "default": 0
    }
  ]
}
{% endschema %}

