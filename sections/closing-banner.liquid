{% render 'section-editor-styles', section: section %}
{% liquid
  assign overlay_alpha = section.settings.overlay_opacity | times: 0.01
  assign overlay_light = overlay_alpha | times: 0.44
%}
{% assign closing_mobile_image = section.settings.image_mobile %}
{% assign closing_fit = section.settings.image_fit | default: 'cover' %}
{% assign closing_fit_m = section.settings.image_fit_mobile | default: 'cover' %}
{% assign closing_radius = section.settings.image_radius | default: 0 %}
<style>
  {% if closing_radius > 0 %}
    #shopify-section-{{ section.id }} .pp-closing { border-radius: {{ closing_radius }}px; overflow: hidden; }
  {% endif %}
  #shopify-section-{{ section.id }} .pp-closing { background-size: {{ closing_fit }}; }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .pp-closing {
      background-size: {{ closing_fit_m }};
      {% if closing_mobile_image != blank %}background-image: url('{{ closing_mobile_image | image_url: width: 1200 }}');{% endif %}
      background-position: {{ section.settings.background_position_mobile | default: 'center' }};
    }
  }
</style>
<section class="pp-closing" style="--closing-position:{{ section.settings.background_position }};--closing-height:{{ section.settings.min_height }}px;{% if section.settings.image != blank %}--closing:url('{{ section.settings.image | image_url: width: 2200 }}'){% endif %}">
  <style>@media (max-width:990px){ #shopify-section-{{ section.id }} .pp-closing { min-height: {{ section.settings.min_height_mobile | default: 470 }}px; } }</style>
  <div class="pp-closing__overlay" style="background:linear-gradient(90deg,{{ section.settings.overlay_color | color_modify: 'alpha', overlay_alpha }},{{ section.settings.overlay_color | color_modify: 'alpha', overlay_light }})"></div>
  <div class="page-width pp-closing__inner{% if section.settings.center_text %} pp-closing__inner--center{% endif %}">
    <div class="pp-kicker pp-kicker--green">{{ section.settings.eyebrow }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% if section.settings.label != blank %}<a class="pp-btn pp-btn--white" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.label }} {% render 'icon-arrow' %}</a>{% endif %}
  </div>
</section>
