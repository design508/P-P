<section class="pp-section pp-collection-range pp-reveal">
  <div class="page-width">
    <div class="pp-products__head pp-collection-range__head">
      <div><div class="pp-kicker">{{ range_eyebrow }}</div><h2>{{ range_heading }}</h2><p>{{ section.settings.intro_text }}</p></div>
    </div>

    {% if h == 'all' and section.settings.show_search_filters %}
      <div class="pp-shop-tools">
        <label class="pp-shop-search"><span>⌕</span><input type="search" placeholder="{{ section.settings.search_placeholder }}" data-product-search></label>
        <div class="pp-filter-pills" data-filter-pills>
          <button class="is-active" type="button" data-filter="all">{{ section.settings.all_filter_label }}</button>
          {% for block in section.blocks %}<button type="button" data-filter="{{ block.settings.handle | handle }}" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>{% endfor %}
        </div>
        <span class="pp-result-count" data-result-count data-label="{{ section.settings.product_count_label | escape }}">{{ collection.products_count }} {{ section.settings.product_count_label }}</span>
      </div>
    {% endif %}

    <div class="pp-product-grid" data-product-grid>
      {% paginate collection.products by section.settings.products_per_page %}
        {% for product in collection.products %}
          <div data-product-item data-product-type="{{ product.type | handle }}" data-product-title="{{ product.title | escape | downcase }} {{ product.description | strip_html | escape | downcase }}">
            {% render 'product-card', product: product, eyebrow: product.type %}
          </div>
        {% endfor %}
        <div class="pp-pagination">{{ paginate | default_pagination }}</div>
      {% endpaginate %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_override",
      "label": "Hero eyebrow override"
    },
    {
      "type": "textarea",
      "id": "heading_override",
      "label": "Hero heading override"
    },
    {
      "type": "textarea",
      "id": "text_override",
      "label": "Hero text override"
    },
    {
      "type": "text",
      "id": "range_eyebrow_override",
      "label": "Product range eyebrow override"
    },
    {
      "type": "text",
      "id": "range_heading_override",
      "label": "Product range heading override"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Product range text",
      "default": "Choose a product to see benefits, when to use it and a simple routine."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "checkbox",
      "id": "show_hero_products",
      "label": "Show hero artwork area",
      "default": true
    },
    {
      "type": "color",
      "id": "hero_background",
      "label": "Hero background",
      "default": "#fffafd"
    },
    {"type": "header", "content": "Hero image 1 — desktop"},
    {"type": "image_picker", "id": "hero_image_1", "label": "Hero image 1 (desktop)", "info": "A transparent PNG works best."},
    {"type": "header", "content": "Hero image 1 — mobile"},
    {"type": "image_picker", "id": "hero_image_1_mobile", "label": "Hero image 1 — mobile (optional)", "info": "Shown at 990px and narrower instead of the desktop image above. Leave empty to use the same image on mobile."},
