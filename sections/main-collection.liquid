{% render 'section-editor-styles', section: section %}
{% liquid
  assign h = collection.handle
  assign eyebrow = collection.title | upcase
  assign hero_heading = collection.title
  assign hero_text = collection.description | strip_html
  assign range_eyebrow = collection.title | append: ' range' | upcase
  assign range_heading = collection.products_count | append: ' clear solutions.'
  assign mf_eyebrow = collection.metafields.custom.eyebrow.value | default: collection.metafields.custom.eyebrow
  assign mf_description = collection.metafields.custom.short_description.value | default: collection.metafields.custom.short_description
  assign mf_hero_image = collection.metafields.custom.hero_image.value
  assign mf_accent = collection.metafields.custom.accent_color.value | default: collection.metafields.custom.accent_color

  if h == 'grooming'
    assign hero_heading = 'Care for every coat story.'
    assign hero_text = 'Shampoos, conditioner, dry baths and paw care arranged around the concern—not the clutter.'
    assign range_heading = '8 clear solutions.'
  elsif h == 'nutrition'
    assign hero_heading = 'Daily support, made clear.'
    assign hero_text = 'Straightforward formulas for skin, coat, bones, activity and everyday wellness.'
    assign range_heading = '3 clear solutions.'
  elsif h == 'treats'
    assign hero_heading = 'Rewards with a thoughtful twist.'
    assign hero_text = 'Pet-friendly favourites for lick mats, training moments and post-bath peace treaties.'
    assign range_heading = '1 clear solution.'
  elsif h == 'all'
    assign eyebrow = 'SHOP ALL'
    assign hero_heading = 'Find their next favourite.'
    assign hero_text = 'Search the complete range or narrow it down by the kind of care they need.'
    assign range_eyebrow = 'ALL CARE'
    assign range_heading = 'Complete range'
  endif

  if mf_eyebrow != blank
    assign eyebrow = mf_eyebrow
  endif
  if mf_description != blank
    assign hero_text = mf_description
  endif

  if section.settings.eyebrow_override != blank
    assign eyebrow = section.settings.eyebrow_override
  endif
  if section.settings.heading_override != blank
    assign hero_heading = section.settings.heading_override
  endif
  if section.settings.text_override != blank
    assign hero_text = section.settings.text_override
  endif
  if section.settings.range_eyebrow_override != blank
    assign range_eyebrow = section.settings.range_eyebrow_override
  endif
  if section.settings.range_heading_override != blank
    assign range_heading = section.settings.range_heading_override
  endif

  assign has_custom_hero = false
  if mf_hero_image != blank
    assign has_custom_hero = true
  endif
  if section.settings.hero_image_1 != blank or section.settings.hero_image_1_mobile != blank
    assign has_custom_hero = true
  endif
  if section.settings.hero_image_2 != blank or section.settings.hero_image_2_mobile != blank
    assign has_custom_hero = true
  endif
  if section.settings.hero_image_3 != blank or section.settings.hero_image_3_mobile != blank
    assign has_custom_hero = true
  endif
%}

