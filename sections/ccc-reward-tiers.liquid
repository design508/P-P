{% comment %}
  Creator Club — Reward Tiers
  IMPORTANT: Do not hard-code real reward amounts/percentages here. Every block
  defaults to "Reward details will be announced soon." until the merchant fills
  in final reward copy in the Theme Editor.
{% endcomment %}
{% render 'section-editor-styles', section: section %}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-tiers {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-tiers__head { text-align: center; margin-bottom: 40px; }
  #shopify-section-{{ section.id }} .pp-ccc-tiers__label {
    display: block;
    font-family: var(--body);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: .14em;
    color: {{ section.settings.accent_color }};
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-tiers h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 3.4vw, 42px);
    color: var(--ink, #351042);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .pp-ccc-tiers__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 22px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-tier {
    position: relative;
    border-radius: 22px;
    padding: 28px 24px;
    border: 2px solid var(--pp-tier-border, #eee0ee);
    background: linear-gradient(145deg, var(--pp-tier-bg, #fff), color-mix(in srgb, var(--pp-tier-bg, #fff) 55%, white));
    color: var(--pp-tier-text, #351042);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease;
  }
  #shopify-section-{{ section.id }} .pp-ccc-tier:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 38px -18px color-mix(in srgb, var(--pp-tier-border, #eee0ee) 60%, rgba(53,16,66,.3));
  }
  #shopify-section-{{ section.id }} .pp-ccc-tier--highlight {
    box-shadow: 0 16px 40px -18px rgba(53,16,66,.28);
    transform: translateY(-4px);
  }
  #shopify-section-{{ section.id }} .pp-ccc-tier--highlight:hover {
    transform: translateY(-9px);
  }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-tier--highlight {
      animation: pp-ccc-tier-glow 3.2s ease-in-out infinite;
    }
    @keyframes pp-ccc-tier-glow {
      0%, 100% { box-shadow: 0 16px 40px -18px rgba(53,16,66,.28); }
      50% { box-shadow: 0 20px 46px -14px color-mix(in srgb, var(--pp-tier-border, #eee0ee) 70%, rgba(53,16,66,.4)); }
    }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-tier--highlight { animation: none !important; }
  #shopify-section-{{ section.id }} .pp-ccc-tier__badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};
    font-family: var(--body);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .06em;
    padding: 5px 12px;
    border-radius: 999px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-tier__icon { width: 44px; height: 44px; border-radius: 12px; background: rgba(0,0,0,.05); display: grid; place-items: center; margin-bottom: 4px; }
  #shopify-section-{{ section.id }} .pp-ccc-tier__icon img { width: 26px; height: 26px; object-fit: contain; }
  #shopify-section-{{ section.id }} .pp-ccc-tier__name { font-family: var(--display); font-weight: 700; font-size: 20px; margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-tier__range { font-family: var(--body); font-size: 13px; font-weight: 700; opacity: .75; }
  #shopify-section-{{ section.id }} .pp-ccc-tier__reward-title { font-family: var(--body); font-weight: 800; font-size: 15px; margin-top: 6px; }
  #shopify-section-{{ section.id }} .pp-ccc-tier__reward-desc { font-family: var(--body); font-size: 14px; line-height: 1.55; opacity: .85; margin: 0; }
  /* Twinkling sparkles near the highlighted tier's badge. Confetti-on-hover
     for every tier card is handled by pp-creator-club.js (initTierConfetti),
     which reads --pp-tier-border below, so no CSS is needed for that part. */
  #shopify-section-{{ section.id }} .pp-ccc-tier__sparkle {
    position: absolute;
    top: -18px;
    font-size: 16px;
    color: {{ section.settings.badge_bg }};
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .pp-ccc-tier__sparkle--a { right: 8px; }
  #shopify-section-{{ section.id }} .pp-ccc-tier__sparkle--b { right: 34px; top: -10px; font-size: 11px; }
  @media (prefers-reduced-motion: no-preference) {
    #shopify-section-{{ section.id }} .pp-ccc-tier__sparkle { animation: pp-ccc-sparkle-twinkle 2.4s ease-in-out infinite; }
    #shopify-section-{{ section.id }} .pp-ccc-tier__sparkle--b { animation-delay: .5s; }
  }
  @keyframes pp-ccc-sparkle-twinkle {
    0%, 100% { opacity: .2; transform: scale(.7) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(18deg); }
  }
  body.pp-motion-off #shopify-section-{{ section.id }} .pp-ccc-tier__sparkle { animation: none !important; opacity: .7; }
  #shopify-section-{{ section.id }} .pp-ccc-tiers__note {
    margin-top: 28px;
    text-align: center;
    font-family: var(--body);
    font-size: 13px;
    color: var(--muted, #6b5b73);
  }
</style>
<section class="pp-ccc-tiers pp-reveal" id="ccc-rewards">
  <div class="page-width">
    <div class="pp-ccc-tiers__head">
      {% if section.settings.label != blank %}<span class="pp-ccc-tiers__label">{{ section.settings.label }}</span>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="pp-ccc-tiers__grid">
      {% for block in section.blocks %}
        {% if block.type == 'tier' and block.settings.enable %}
          <div class="pp-ccc-tier{% if block.settings.highlighted %} pp-ccc-tier--highlight{% endif %}"
               style="--pp-tier-bg:{{ block.settings.card_bg }};--pp-tier-text:{{ block.settings.text_color }};--pp-tier-border:{{ block.settings.border_color }}"
               data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            {% assign icon_img = block.settings.icon %}
{% assign icon_img_mobile = block.settings.icon_mobile %}
{% assign icon_display = icon_img | default: icon_img_mobile %}
{% assign icon_fit = block.settings.icon_fit | default: 'contain' %}
{% assign icon_position = block.settings.icon_position | default: 'center center' %}
{% assign icon_fit_m = block.settings.icon_fit_mobile | default: 'contain' %}
{% assign icon_position_m = block.settings.icon_position_mobile | default: 'center center' %}
{% assign icon_radius = block.settings.icon_radius | default: 0 %}
{% assign icon_radius_m = block.settings.icon_radius_mobile | default: 0 %}
{% assign icon_w = block.settings.icon_max_width | default: 0 %}
{% assign icon_h = block.settings.icon_max_height | default: 0 %}
{% assign icon_w_m = block.settings.icon_max_width_mobile | default: 0 %}
{% assign icon_h_m = block.settings.icon_max_height_mobile | default: 0 %}
{% assign icon_ha = block.settings.icon_h_align | default: 'default' %}
{% assign icon_va = block.settings.icon_v_align | default: 'default' %}
{% assign icon_ha_m = block.settings.icon_h_align_mobile | default: 'default' %}
{% assign icon_va_m = block.settings.icon_v_align_mobile | default: 'default' %}
            <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-ccc-tier[data-pp-block-id="{{ block.id }}"] .pp-ccc-tier__icon img { object-fit: {{ icon_fit }}; object-position: {{ icon_position }}; }
  #shopify-section-{{ section.id }} .pp-ccc-tier[data-pp-block-id="{{ block.id }}"] .pp-ccc-tier__icon {
    {% if icon_radius > 0 %}border-radius: {{ icon_radius }}px; overflow: hidden;{% endif %}
    {% if icon_w > 0 %}width: min({{ icon_w }}px, 100%); max-width: 100%;{% endif %}
    {% if icon_h > 0 %}height: min({{ icon_h }}px, 100%); max-height: 100%;{% endif %}
    {% if icon_ha == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if icon_ha == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if icon_ha == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if icon_va == 'top' %}align-self: flex-start;{% endif %}
    {% if icon_va == 'center' %}align-self: center;{% endif %}
    {% if icon_va == 'bottom' %}align-self: flex-end;{% endif %}
  }
}
@media (max-width: 990px) {
  #shopify-section-{{ section.id }} .pp-ccc-tier[data-pp-block-id="{{ block.id }}"] .pp-ccc-tier__icon img { object-fit: {{ icon_fit_m }}; object-position: {{ icon_position_m }}; }
  #shopify-section-{{ section.id }} .pp-ccc-tier[data-pp-block-id="{{ block.id }}"] .pp-ccc-tier__icon {
    {% if icon_radius_m > 0 %}border-radius: {{ icon_radius_m }}px; overflow: hidden;{% endif %}
    {% if icon_w_m > 0 %}width: min({{ icon_w_m }}px, 100%); max-width: 100%;{% endif %}
    {% if icon_h_m > 0 %}height: min({{ icon_h_m }}px, 100%); max-height: 100%;{% endif %}
    {% if icon_ha_m == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if icon_ha_m == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if icon_ha_m == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if icon_va_m == 'top' %}align-self: flex-start;{% endif %}
    {% if icon_va_m == 'center' %}align-self: center;{% endif %}
    {% if icon_va_m == 'bottom' %}align-self: flex-end;{% endif %}
  }
}</style>
            {% if block.settings.badge_text != blank %}<span class="pp-ccc-tier__badge">{{ block.settings.badge_text }}</span>{% endif %}
            {% if block.settings.highlighted %}
              <span class="pp-ccc-tier__sparkle pp-ccc-tier__sparkle--a" aria-hidden="true">✦</span>
              <span class="pp-ccc-tier__sparkle pp-ccc-tier__sparkle--b" aria-hidden="true">✦</span>
            {% endif %}
            {% if icon_display != blank %}
              <div class="pp-ccc-tier__icon">
  <picture>
    {% if icon_img_mobile != blank and icon_img_mobile != icon_img %}
      <source media="(max-width: 990px)" srcset="{{ icon_img_mobile | image_url: width: 400 }} 400w, {{ icon_img_mobile | image_url: width: 600 }} 600w, {{ icon_img_mobile | image_url: width: 800 }} 800w, {{ icon_img_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    {% endif %}
    {{ icon_display | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
  </picture>
              </div>
            {% endif %}
            <h3 class="pp-ccc-tier__name">{{ block.settings.tier_name }}</h3>
            <span class="pp-ccc-tier__range">
              {%- if block.settings.max_views > 0 -%}
                {{ block.settings.min_views }}–{{ block.settings.max_views }} views
              {%- else -%}
                {{ block.settings.min_views }}+ views
              {%- endif -%}
            </span>
            <div class="pp-ccc-tier__reward-title">{{ block.settings.reward_title }}</div>
            <p class="pp-ccc-tier__reward-desc">{{ block.settings.reward_description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.footnote != blank %}<p class="pp-ccc-tiers__note">{{ section.settings.footnote }}</p>{% endif %}
  </div>
</section>
{% schema %}
{"name":"CC — Reward Tiers","settings":[{"type":"paragraph","content":"⚠️ Merchant action needed: every tier below shows a placeholder reward until you enter final reward amounts, thresholds and terms. Do not make this page publicly available until reward details are finalized — placeholder blocks intentionally avoid promising any specific amount or percentage."},{"type":"text","id":"label","label":"Label","default":"MORE LOVE. MORE REACH. MORE REWARDS."},{"type":"text","id":"heading","label":"Heading","default":"Every view deserves a little tail wag."},{"type":"textarea","id":"footnote","label":"Footnote below tiers","default":"Final reward values, thresholds and payout timelines will be announced soon."},{"type":"header","content":"Colours"},{"type":"color","id":"background","label":"Section background","default":"#ffffff"},{"type":"color","id":"accent_color","label":"Label colour","default":"#ff5a0a"},{"type":"color","id":"badge_bg","label":"Badge background","default":"#47105d"},{"type":"color","id":"badge_text_color","label":"Badge text colour","default":"#ffffff"},{"type":"header","content":"Section spacing"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Top padding — desktop","default":64},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Bottom padding — desktop","default":64}],"blocks":[{"type":"tier","name":"Reward tier","settings":[{"type":"checkbox","id":"enable","label":"Enable this tier","default":true},{"type":"text","id":"tier_name","label":"Tier name","default":"Happy Tail"},{"type":"number","id":"min_views","label":"Minimum views","default":1000},{"type":"number","id":"max_views","label":"Maximum views (0 = no upper limit)","default":5000},{"type":"text","id":"reward_title","label":"Reward title","default":"Reward details will be announced soon."},{"type":"textarea","id":"reward_description","label":"Reward description","default":"Reward details will be announced soon."},{"type":"header","content":"Icon or image (optional) — desktop"},{"type":"image_picker","id":"icon","label":"Icon or image (optional) (desktop)","info":"A transparent PNG works best."},{"type":"header","content":"Icon or image (optional) — mobile"},{"type":"image_picker","id":"icon_mobile","label":"Icon or image (optional) — mobile (optional)","info":"Shown at 990px and narrower instead of the desktop image above. Leave empty to use the same image on mobile."},{"type":"header","content":"Image fit — desktop"},{"type":"select","id":"icon_fit","label":"How the photo fills its box","default":"contain","options":[{"value":"contain","label":"Show the whole photo (may leave empty space)"},{"value":"cover","label":"Fill the box completely (may crop)"}]},{"type":"select","id":"icon_position","label":"Photo alignment inside its box","info":"Only matters when the photo's shape doesn't exactly match the box.","default":"center center","options":[{"value":"left top","label":"Top left"},{"value":"center top","label":"Top center"},{"value":"right top","label":"Top right"},{"value":"left center","label":"Middle left"},{"value":"center center","label":"Middle center"},{"value":"right center","label":"Middle right"},{"value":"left bottom","label":"Bottom left"},{"value":"center bottom","label":"Bottom center"},{"value":"right bottom","label":"Bottom right"}]},{"type":"header","content":"Image fit — mobile"},{"type":"select","id":"icon_fit_mobile","label":"How the photo fills its box","default":"contain","options":[{"value":"contain","label":"Show the whole photo (may leave empty space)"},{"value":"cover","label":"Fill the box completely (may crop)"}]},{"type":"select","id":"icon_position_mobile","label":"Photo alignment inside its box","info":"Only matters when the photo's shape doesn't exactly match the box.","default":"center center","options":[{"value":"left top","label":"Top left"},{"value":"center top","label":"Top center"},{"value":"right top","label":"Top right"},{"value":"left center","label":"Middle left"},{"value":"center center","label":"Middle center"},{"value":"right center","label":"Middle right"},{"value":"left bottom","label":"Bottom left"},{"value":"center bottom","label":"Bottom center"},{"value":"right bottom","label":"Bottom right"}]},{"type":"header","content":"Corner rounding — desktop"},{"type":"range","id":"icon_radius","min":0,"max":60,"step":2,"unit":"px","label":"Corner rounding (0 = theme default)","default":0},{"type":"header","content":"Corner rounding — mobile"},{"type":"range","id":"icon_radius_mobile","min":0,"max":60,"step":2,"unit":"px","label":"Corner rounding (0 = theme default)","default":0},{"type":"header","content":"Image size — desktop"},{"type":"range","id":"icon_max_width","min":0,"max":1500,"step":50,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"icon_max_height","min":0,"max":1000,"step":50,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Image size — mobile"},{"type":"range","id":"icon_max_width_mobile","min":0,"max":900,"step":25,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"icon_max_height_mobile","min":0,"max":700,"step":25,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Box position — desktop"},{"type":"select","id":"icon_h_align","label":"Horizontal position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"icon_v_align","label":"Vertical position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"header","content":"Box position — mobile"},{"type":"select","id":"icon_h_align_mobile","label":"Horizontal position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"icon_v_align_mobile","label":"Vertical position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"text","id":"badge_text","label":"Badge text (optional)"},{"type":"color","id":"card_bg","label":"Card background","default":"#fdf7fb"},{"type":"color","id":"text_color","label":"Text colour","default":"#351042"},{"type":"color","id":"border_color","label":"Border colour","default":"#eee0ee"},{"type":"checkbox","id":"highlighted","label":"Highlight this tier","default":false}]}],"presets":[{"name":"CC — Reward Tiers","blocks":[{"type":"tier","settings":{"tier_name":"Happy Tail","min_views":1000,"max_views":5000}},{"type":"tier","settings":{"tier_name":"Zoomie Star","min_views":5000,"max_views":20000}},{"type":"tier","settings":{"tier_name":"Pack Favourite","min_views":20000,"max_views":100000,"highlighted":true}},{"type":"tier","settings":{"tier_name":"Internet's Best Friend","min_views":100000,"max_views":0,"badge_text":"TOP TIER"}}]}]}
{% endschema %}
