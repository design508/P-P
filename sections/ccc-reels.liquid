{% comment %}
  Creator Club — Real Pet-Parent Reels
  Auto-hides on the storefront when no reel blocks are enabled with content;
  shows a Theme Editor–only placeholder in that case instead.
{% endcomment %}
{% render 'section-editor-styles', section: section %}
{% liquid
  assign visible_reels = 0
  for block in section.blocks
    assign reel_has_cover = false
    if block.settings.cover_image != blank
      assign reel_has_cover = true
    endif
    if block.settings.cover_image_mobile != blank
      assign reel_has_cover = true
    endif
    if block.type == 'reel' and block.settings.enable and reel_has_cover
      assign visible_reels = visible_reels | plus: 1
    endif
  endfor
%}
<style>
  #shopify-section-{{ section.id }} .pp-ccc-reels {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-reels__head { text-align: center; margin-bottom: 32px; }
  #shopify-section-{{ section.id }} .pp-ccc-reels__label { display:block; font-family: var(--body); font-weight: 800; font-size: 13px; letter-spacing: .14em; color: {{ section.settings.accent_color }}; margin-bottom: 12px; }
  #shopify-section-{{ section.id }} .pp-ccc-reels h2 { font-family: var(--display); font-weight: 800; font-size: clamp(28px,3.4vw,42px); color: var(--ink,#351042); margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-reels__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding: 6px 4px 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  #shopify-section-{{ section.id }} .pp-ccc-reel {
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: min(78vw, 260px);
    border-radius: 22px;
    overflow: hidden;
    background: #fff;
    border: 3px solid var(--pp-reel-border, var(--orange, #ff5a0a));
    box-shadow: 0 12px 28px -18px rgba(53,16,66,.25);
    transform: rotate(var(--pp-reel-tilt, 0deg));
    transition: transform .25s ease, box-shadow .25s ease;
  }
  /* Polaroid-style colourful frame, cycling per card, with a light stack
     tilt that straightens out on hover/focus. */
  #shopify-section-{{ section.id }} .pp-ccc-reels__track > .pp-ccc-reel:nth-child(3n+1) { --pp-reel-border: var(--orange, #ff5a0a); --pp-reel-tilt: -1.6deg; }
  #shopify-section-{{ section.id }} .pp-ccc-reels__track > .pp-ccc-reel:nth-child(3n+2) { --pp-reel-border: var(--pink, #ff2b78); --pp-reel-tilt: 1.3deg; }
  #shopify-section-{{ section.id }} .pp-ccc-reels__track > .pp-ccc-reel:nth-child(3n+3) { --pp-reel-border: var(--purple2, #5b1a74); --pp-reel-tilt: -1.1deg; }
  #shopify-section-{{ section.id }} .pp-ccc-reel:hover,
  #shopify-section-{{ section.id }} .pp-ccc-reel:focus-within {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 18px 36px -18px rgba(53,16,66,.35);
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pp-ccc-reel { transition: none; }
  }
  #shopify-section-{{ section.id }} .pp-ccc-reel__media {
    position: relative;
    aspect-ratio: 9/16;
    background: #f3e9f8;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .pp-ccc-reel__media img,
  #shopify-section-{{ section.id }} .pp-ccc-reel__media video { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .pp-ccc-reel__play {
    position: absolute; inset: 0; display: grid; place-items: center;
    background: rgba(53,16,66,.18);
    border: 0; cursor: pointer; color: #fff; font-size: 34px;
  }
  #shopify-section-{{ section.id }} .pp-ccc-reel__play[hidden] { display: none; }
  #shopify-section-{{ section.id }} .pp-ccc-reel__body { padding: 14px 16px 18px; }
  #shopify-section-{{ section.id }} .pp-ccc-reel__pet { font-family: var(--body); font-weight: 800; font-size: 14px; color: var(--ink,#351042); margin: 0; }
  #shopify-section-{{ section.id }} .pp-ccc-reel__handle { font-family: var(--body); font-size: 12.5px; color: {{ section.settings.accent_color }}; margin: 2px 0 6px; }
  #shopify-section-{{ section.id }} .pp-ccc-reel__caption { font-family: var(--body); font-size: 13px; color: var(--muted,#6b5b73); margin: 0; line-height: 1.5; }
  #shopify-section-{{ section.id }} .pp-ccc-reels__dots { display: flex; justify-content: center; gap: 8px; margin-top: 6px; }
  #shopify-section-{{ section.id }} .pp-ccc-reels__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line,#eee0ee); border: 0; padding: 0; cursor: pointer; transition: background .2s ease, transform .2s ease; }
  #shopify-section-{{ section.id }} .pp-ccc-reels__dot.is-active { background: {{ section.settings.accent_color }}; transform: scale(1.3); }
  #shopify-section-{{ section.id }} .pp-ccc-reels__dot:nth-child(3n+1).is-active { background: var(--orange, #ff5a0a); }
  #shopify-section-{{ section.id }} .pp-ccc-reels__dot:nth-child(3n+2).is-active { background: var(--pink, #ff2b78); }
  #shopify-section-{{ section.id }} .pp-ccc-reels__dot:nth-child(3n+3).is-active { background: var(--purple2, #5b1a74); }
  #shopify-section-{{ section.id }} .pp-ccc-reels__empty {
    text-align: center;
    border: 2px dashed var(--line,#eee0ee);
    border-radius: 20px;
    padding: 48px 20px;
    color: var(--muted,#6b5b73);
    font-family: var(--body);
  }
</style>

{% if visible_reels > 0 %}
  <section class="pp-ccc-reels pp-reveal" data-ccc-reels>
    <div class="page-width">
      <div class="pp-ccc-reels__head">
        {% if section.settings.label != blank %}<span class="pp-ccc-reels__label">{{ section.settings.label }}</span>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="pp-ccc-reels__track" data-ccc-reels-track>
        {% for block in section.blocks %}
          {% assign reel_has_cover = false %}
          {% if block.settings.cover_image != blank %}{% assign reel_has_cover = true %}{% endif %}
          {% if block.settings.cover_image_mobile != blank %}{% assign reel_has_cover = true %}{% endif %}
          {% if block.type == 'reel' and block.settings.enable and reel_has_cover %}
            {% assign cover_image_img = block.settings.cover_image %}
{% assign cover_image_img_mobile = block.settings.cover_image_mobile %}
{% assign cover_image_display = cover_image_img | default: cover_image_img_mobile %}
{% assign cover_image_fit = block.settings.cover_image_fit | default: 'contain' %}
{% assign cover_image_position = block.settings.cover_image_position | default: 'center center' %}
{% assign cover_image_fit_m = block.settings.cover_image_fit_mobile | default: 'contain' %}
{% assign cover_image_position_m = block.settings.cover_image_position_mobile | default: 'center center' %}
{% assign cover_image_radius = block.settings.cover_image_radius | default: 0 %}
{% assign cover_image_radius_m = block.settings.cover_image_radius_mobile | default: 0 %}
{% assign cover_image_w = block.settings.cover_image_max_width | default: 0 %}
{% assign cover_image_h = block.settings.cover_image_max_height | default: 0 %}
{% assign cover_image_w_m = block.settings.cover_image_max_width_mobile | default: 0 %}
{% assign cover_image_h_m = block.settings.cover_image_max_height_mobile | default: 0 %}
{% assign cover_image_ha = block.settings.cover_image_h_align | default: 'default' %}
{% assign cover_image_va = block.settings.cover_image_v_align | default: 'default' %}
{% assign cover_image_ha_m = block.settings.cover_image_h_align_mobile | default: 'default' %}
{% assign cover_image_va_m = block.settings.cover_image_v_align_mobile | default: 'default' %}
            <style>@media (min-width: 991px) {
  #shopify-section-{{ section.id }} .pp-ccc-reel[data-pp-block-id="{{ block.id }}"] .pp-ccc-reel__media img { object-fit: {{ cover_image_fit }}; object-position: {{ cover_image_position }}; }
  #shopify-section-{{ section.id }} .pp-ccc-reel[data-pp-block-id="{{ block.id }}"] .pp-ccc-reel__media {
    {% if cover_image_radius > 0 %}border-radius: {{ cover_image_radius }}px; overflow: hidden;{% endif %}
    {% if cover_image_w > 0 %}width: min({{ cover_image_w }}px, 100%); max-width: 100%;{% endif %}
    {% if cover_image_h > 0 %}height: min({{ cover_image_h }}px, 100%); max-height: 100%;{% endif %}
    {% if cover_image_ha == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if cover_image_ha == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if cover_image_ha == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if cover_image_va == 'top' %}align-self: flex-start;{% endif %}
    {% if cover_image_va == 'center' %}align-self: center;{% endif %}
    {% if cover_image_va == 'bottom' %}align-self: flex-end;{% endif %}
  }
}
@media (max-width: 990px) {
  #shopify-section-{{ section.id }} .pp-ccc-reel[data-pp-block-id="{{ block.id }}"] .pp-ccc-reel__media img { object-fit: {{ cover_image_fit_m }}; object-position: {{ cover_image_position_m }}; }
  #shopify-section-{{ section.id }} .pp-ccc-reel[data-pp-block-id="{{ block.id }}"] .pp-ccc-reel__media {
    {% if cover_image_radius_m > 0 %}border-radius: {{ cover_image_radius_m }}px; overflow: hidden;{% endif %}
    {% if cover_image_w_m > 0 %}width: min({{ cover_image_w_m }}px, 100%); max-width: 100%;{% endif %}
    {% if cover_image_h_m > 0 %}height: min({{ cover_image_h_m }}px, 100%); max-height: 100%;{% endif %}
    {% if cover_image_ha_m == 'left' %}margin-left: 0; margin-right: auto;{% endif %}
    {% if cover_image_ha_m == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
    {% if cover_image_ha_m == 'right' %}margin-left: auto; margin-right: 0;{% endif %}
    {% if cover_image_va_m == 'top' %}align-self: flex-start;{% endif %}
    {% if cover_image_va_m == 'center' %}align-self: center;{% endif %}
    {% if cover_image_va_m == 'bottom' %}align-self: flex-end;{% endif %}
  }
}</style>
            <article class="pp-ccc-reel" data-pp-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="pp-ccc-reel__media" data-ccc-reel-media
                   {% if block.settings.video != blank %}data-video-id="{{ block.settings.video.id }}"{% endif %}
                   {% if block.settings.instagram_url != blank %}data-instagram-url="{{ block.settings.instagram_url | escape }}"{% endif %}>
                <picture>
                  {% if cover_image_img_mobile != blank and cover_image_img_mobile != cover_image_img %}
                    <source media="(max-width: 990px)" srcset="{{ cover_image_img_mobile | image_url: width: 300 }} 300w, {{ cover_image_img_mobile | image_url: width: 500 }} 500w" sizes="260px">
                  {% endif %}
                  <img src="{{ cover_image_display | image_url: width: 500 }}" srcset="{{ cover_image_display | image_url: width: 300 }} 300w, {{ cover_image_display | image_url: width: 500 }} 500w" sizes="260px" loading="lazy" width="500" height="889" alt="{{ block.settings.pet_name | default: 'Pups & Paws creator reel' }}" data-ccc-reel-cover>
                </picture>
                {% if block.settings.video != blank or block.settings.instagram_url != blank %}
                  <button type="button" class="pp-ccc-reel__play" data-ccc-reel-play aria-label="Play reel featuring {{ block.settings.pet_name }}">▶</button>
                {% endif %}
              </div>
              <div class="pp-ccc-reel__body">
                {% if block.settings.pet_name != blank %}<p class="pp-ccc-reel__pet">{{ block.settings.pet_name }}</p>{% endif %}
                {% if block.settings.handle != blank %}<p class="pp-ccc-reel__handle">{{ block.settings.handle }}</p>{% endif %}
                {% if block.settings.caption != blank %}<p class="pp-ccc-reel__caption">{{ block.settings.caption }}</p>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
      <div class="pp-ccc-reels__dots" data-ccc-reels-dots aria-hidden="true"></div>
    </div>
  </section>
{% elsif request.design_mode %}
  <section class="pp-ccc-reels pp-reveal">
    <div class="page-width">
      <div class="pp-ccc-reels__head">
        {% if section.settings.label != blank %}<span class="pp-ccc-reels__label">{{ section.settings.label }}</span>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="pp-ccc-reels__empty">
        <strong>No reels added yet.</strong>
        <p>Add "Reel" blocks with a cover image (and optionally a Shopify-hosted video or Instagram reel link) to fill this gallery. This section is hidden from the live storefront until at least one reel with a cover image is enabled.</p>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{"name":"Creator Club — Reels","settings":[{"type":"text","id":"label","label":"Label","default":"SEEN IN THE WILD"},{"type":"text","id":"heading","label":"Heading","default":"Made by pets. Filmed by their humans."},{"type":"header","content":"Colours"},{"type":"color","id":"background","label":"Section background","default":"#fdf7fb"},{"type":"color","id":"accent_color","label":"Accent colour","default":"#ff5a0a"},{"type":"header","content":"Section spacing"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Top padding — desktop","default":64},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Bottom padding — desktop","default":64}],"blocks":[{"type":"reel","name":"Reel","settings":[{"type":"checkbox","id":"enable","label":"Enable this reel","default":true},{"type":"header","content":"Cover image (required to show) — desktop"},{"type":"image_picker","id":"cover_image","label":"Cover image (required to show) (desktop)","info":"A transparent PNG works best."},{"type":"header","content":"Cover image (required to show) — mobile"},{"type":"image_picker","id":"cover_image_mobile","label":"Cover image (required to show) — mobile (optional)","info":"Shown at 990px and narrower instead of the desktop image above. Leave empty to use the same image on mobile."},{"type":"header","content":"Image fit — desktop"},{"type":"select","id":"cover_image_fit","label":"How the photo fills its box","default":"contain","options":[{"value":"contain","label":"Show the whole photo (may leave empty space)"},{"value":"cover","label":"Fill the box completely (may crop)"}]},{"type":"select","id":"cover_image_position","label":"Photo alignment inside its box","info":"Only matters when the photo's shape doesn't exactly match the box.","default":"center center","options":[{"value":"left top","label":"Top left"},{"value":"center top","label":"Top center"},{"value":"right top","label":"Top right"},{"value":"left center","label":"Middle left"},{"value":"center center","label":"Middle center"},{"value":"right center","label":"Middle right"},{"value":"left bottom","label":"Bottom left"},{"value":"center bottom","label":"Bottom center"},{"value":"right bottom","label":"Bottom right"}]},{"type":"header","content":"Image fit — mobile"},{"type":"select","id":"cover_image_fit_mobile","label":"How the photo fills its box","default":"contain","options":[{"value":"contain","label":"Show the whole photo (may leave empty space)"},{"value":"cover","label":"Fill the box completely (may crop)"}]},{"type":"select","id":"cover_image_position_mobile","label":"Photo alignment inside its box","info":"Only matters when the photo's shape doesn't exactly match the box.","default":"center center","options":[{"value":"left top","label":"Top left"},{"value":"center top","label":"Top center"},{"value":"right top","label":"Top right"},{"value":"left center","label":"Middle left"},{"value":"center center","label":"Middle center"},{"value":"right center","label":"Middle right"},{"value":"left bottom","label":"Bottom left"},{"value":"center bottom","label":"Bottom center"},{"value":"right bottom","label":"Bottom right"}]},{"type":"header","content":"Corner rounding — desktop"},{"type":"range","id":"cover_image_radius","min":0,"max":60,"step":2,"unit":"px","label":"Corner rounding (0 = theme default)","default":0},{"type":"header","content":"Corner rounding — mobile"},{"type":"range","id":"cover_image_radius_mobile","min":0,"max":60,"step":2,"unit":"px","label":"Corner rounding (0 = theme default)","default":0},{"type":"header","content":"Image size — desktop"},{"type":"range","id":"cover_image_max_width","min":0,"max":1500,"step":50,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"cover_image_max_height","min":0,"max":1000,"step":50,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 991px and wider. Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Image size — mobile"},{"type":"range","id":"cover_image_max_width_mobile","min":0,"max":900,"step":25,"unit":"px","label":"Image width (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"range","id":"cover_image_max_height_mobile","min":0,"max":700,"step":25,"unit":"px","label":"Image height (0 = automatic)","info":"Applies at 990px and narrower (phones and tablets). Automatically shrinks to fit if the layout doesn't have room, so it never overlaps other content.","default":0},{"type":"header","content":"Box position — desktop"},{"type":"select","id":"cover_image_h_align","label":"Horizontal position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"cover_image_v_align","label":"Vertical position","info":"Applies at 991px and wider. \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"header","content":"Box position — mobile"},{"type":"select","id":"cover_image_h_align_mobile","label":"Horizontal position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},{"type":"select","id":"cover_image_v_align_mobile","label":"Vertical position","info":"Applies at 990px and narrower (phones and tablets). \"Default\" keeps the theme's original spacing.","default":"default","options":[{"value":"default","label":"Default (theme spacing)"},{"value":"top","label":"Top"},{"value":"center","label":"Center"},{"value":"bottom","label":"Bottom"}]},{"type":"video","id":"video","label":"Shopify-hosted video (optional)"},{"type":"url","id":"instagram_url","label":"Instagram reel link (optional, used if no video)"},{"type":"text","id":"pet_name","label":"Pet name"},{"type":"text","id":"handle","label":"Creator handle"},{"type":"textarea","id":"caption","label":"Short caption"}]}],"presets":[{"name":"Creator Club — Reels"}]}
{% endschema %}
