    "ccc_faq": {
      "type": "ccc-faq",
      "blocks": {
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "Do I need thousands of followers?",
            "answer": "<p>Not at all. We care more about genuine pet-parent content than follower count.</p>"
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "Does my pet need to be professionally trained?",
            "answer": "<p>Absolutely not. The funny, chaotic and completely natural moments are often the best ones.</p>"
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "Do you provide a script?",
            "answer": "<p>No stiff scripts here. Create something that feels natural to you and your pet while showing the product clearly.</p>"
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "Does the product need to appear in the reel?",
            "answer": "<p>Yes. The Pups & Paws product should be clearly visible and naturally included in the content.</p>"
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "question": "Can I submit an older reel?",
            "answer": "<p>You may submit it if it meets the current program requirements and features an eligible Pups & Paws purchase.</p>"
          }
        },
        "faq-6": {
          "type": "faq",
          "settings": {
            "question": "How will my reel be verified?",
            "answer": "<p>Submit your reel link and order details through the form. Our team will review the information and contact you.</p>"
          }
        },
        "faq-7": {
          "type": "faq",
          "settings": {
            "question": "When will I receive my reward?",
            "answer": "<p>Reward eligibility and processing depend on the final Creator Club terms.</p>"
